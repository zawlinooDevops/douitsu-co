# ==============================================================================
# DOUITSU LLC — Cloudflare Static Assets HTTP Response Headers Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Self-Hosted TTF Fonts (1 Year Immutable Browser Disk Cache + CORS)
# ------------------------------------------------------------------------------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# 2. Astro Bundled CSS & JavaScript (Hashed File Names - 1 Year Immutable)
# ------------------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# 3. Static Images, WebP & Media Assets (30 Days Immutable Cache)
# ------------------------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=2592000, immutable
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# 4. App Favicons, Touch Icons & PWA Manifest
# ------------------------------------------------------------------------------
/favicon.ico
  Cache-Control: public, max-age=2592000, immutable
/favicon-*.png
  Cache-Control: public, max-age=2592000, immutable
/apple-touch-icon*.png
  Cache-Control: public, max-age=2592000, immutable
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

# ------------------------------------------------------------------------------
# 5. Service Worker (Never Long-Cache to Allow Instant Client Updates)
# ------------------------------------------------------------------------------
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# ------------------------------------------------------------------------------
# 6. HTML Navigation & Documents (Must-Revalidate for Fresh Content Delivery)
# ------------------------------------------------------------------------------
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
