# ==============================================================================
# DOUITSU LLC — Environment Configuration Template
# 
# For Local Development:
#   Copy this file to `.env` and populate the actual secrets:
#   cp .env.example .env
#
# For Cloudflare Pages Production:
#   Configure these exact variable names in:
#   Cloudflare Dashboard > Pages > Settings > Environment Variables
# ==============================================================================

# Cloudflare Turnstile CAPTCHA Keys
# Public site key exposed to the client widget
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFYQzIK4TKPrb3od

# Secret key for server-side verification against challenges.cloudflare.com
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Resend Transactional Email API Key
RESEND_API_KEY=re_your_resend_api_key_here

# Contact Form Email Routing
# Sender email address (must match verified domain in Resend)
CONTACT_FROM_EMAIL=info@douitsu-co.com

# Recipient email address where contact form submissions will be delivered
CONTACT_TO_EMAIL=info@douitsu-co.com
