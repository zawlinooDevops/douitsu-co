---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';

// Prepare serialized search data for client-side Alpine filtering
const initialJobs = siteData.career.jobs.map((j) => ({
  id: j.no,
  cat: j.category,
  text: (
    j.title.ja + ' ' + j.title.en + ' ' + j.title.my + ' ' +
    j.categoryLabel.ja + ' ' + j.categoryLabel.en + ' ' + j.categoryLabel.my + ' ' +
    j.salary.ja + ' ' + j.salary.en + ' ' + j.salary.my + ' ' +
    j.salary.line1.ja + ' ' + j.salary.line2.ja + ' ' +
    j.joinDate.ja + ' ' + j.joinDate.en + ' ' + j.joinDate.my + ' ' +
    j.ageLimit.ja + ' ' + j.ageLimit.en + ' ' + j.ageLimit.my
  ).toLowerCase()
}));
---

<!-- Define client-side dataset safely without escaping hurdles -->
<script is:inline define:vars={{ initialJobs }}>
  window.__CAREER_JOBS__ = initialJobs;
</script>

<!-- ============================================================ -->
<!-- SECTION: CAREER & JOBS (採用・求人情報)                         -->
<!-- ID: #career (Alias: #jobs) / 採用・求人情報                   -->
<!-- ============================================================ -->
<section
  id="career"
  class="py-20 md:py-28 bg-slate-50/90 border-b border-slate-200/60 relative overflow-hidden scroll-mt-24"
  x-data="{
    searchQuery: '',
    selectedCategories: [],
    jobs: window.__CAREER_JOBS__ || [],
    isMatch(id) {
      const j = this.jobs.find(item => item.id === id);
      if (!j) return true;
      if (this.selectedCategories.length > 0 && !this.selectedCategories.includes(j.cat)) return false;
      const q = this.searchQuery.toLowerCase().trim();
      if (!q) return true;
      return j.text.includes(q);
    },
    get visibleCount() {
      return this.jobs.filter(j => this.isMatch(j.id)).length;
    },
    resetFilters() {
      this.searchQuery = '';
      this.selectedCategories = [];
    }
  }"
>
  <div id="jobs" class="absolute -top-24"></div>

  <!-- Background Pattern: Dynamic 45° Diagonal Lines -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-[0.03]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="career-stripes" width="16" height="16" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="16" stroke="#105c8e" stroke-width="1.8" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#career-stripes)" />
    </svg>
  </div>



  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Left-aligned, Modern Japanese Corporate Style) -->
    <SectionHeader
      eyebrow="CAREERS & JOBS"
      title={siteData.career.title}
      subtitle={siteData.career.subtitle}
    />

    <!-- ======================================================== -->
    <!-- CAREER SEARCH & FILTER FORM BAR (FULL WIDTH)             -->
    <!-- ======================================================== -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6 mb-8 transition-all">
      
      <!-- Top Row: Search Box + Result Count Pill + Reset Button -->
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3.5 mb-5">
        
        <!-- Search Input with Search Icon & Clear Button -->
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4 text-douitsu-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            x-model="searchQuery"
            :placeholder="lang === 'ja' ? '職種・キーワードで検索 (例: 介護, 食品, 農業)...' : (lang === 'en' ? 'Search by job title or keyword (e.g. Care, Food)...' : 'အလုပ်အကိုင် သို့မဟုတ် စကားလုံးဖြင့် ရှာဖွေရန်...')"
            class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-200 focus:border-douitsu-primary focus:ring-2 focus:ring-douitsu-primary/20 text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-slate-50/60 hover:bg-white focus:bg-white transition-all outline-hidden"
          />
          <!-- Clear Input Button -->
          <button
            type="button"
            x-show="searchQuery.length > 0"
            @click="searchQuery = ''"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors"
            aria-label="Clear search"
            style="display: none;"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Right Side: Match Count Badge & Reset Filters -->
        <div class="flex items-center gap-2 self-start md:self-auto shrink-0">
          <!-- Result Counter Pill -->
          <div class="px-3.5 py-2 rounded-xl bg-douitsu-ice border border-douitsu-primary/20 text-xs font-bold text-douitsu-primary flex items-center gap-2 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-douitsu-primary animate-pulse"></span>
            <span>
              <span x-show="lang === 'ja'">該当求人: <strong class="text-sm font-extrabold" x-text="visibleCount"></strong> 件</span>
              <span x-show="lang === 'en'" style="display: none;">Found: <strong class="text-sm font-extrabold" x-text="visibleCount"></strong></span>
              <span x-show="lang === 'my'" style="display: none;">ရလဒ်: <strong class="text-sm font-extrabold" x-text="visibleCount"></strong> ခု</span>
            </span>
          </div>

          <!-- Reset Filter Button (Active when filter or search is populated) -->
          <button
            type="button"
            x-show="searchQuery.length > 0 || selectedCategories.length > 0"
            @click="resetFilters()"
            class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs"
            style="display: none;"
          >
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span x-show="lang === 'ja'">条件クリア</span>
            <span x-show="lang === 'en'" style="display: none;">Reset</span>
            <span x-show="lang === 'my'" style="display: none;">ပြန်စစ်မည်</span>
          </button>
        </div>

      </div>

      <!-- Bottom Row: Sector / Category Filter Checkboxes -->
      <div class="pt-3.5 border-t border-slate-100">
        <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2.5">
          <svg class="w-3.5 h-3.5 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
          </svg>
          <span x-show="lang === 'ja'">{siteData.career.filter.sectorLabel.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.career.filter.sectorLabel.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.career.filter.sectorLabel.my}</span>
        </div>

        <!-- Checkbox Pills Container -->
        <div class="flex flex-wrap gap-2 sm:gap-2.5">
          {siteData.career.filter.categories.map((cat) => (
            <label
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs cursor-pointer transition-all select-none"
              :class={`selectedCategories.includes('${cat.id}') ? 'bg-douitsu-primary/10 border-douitsu-primary text-douitsu-primary font-bold shadow-2xs ring-1 ring-douitsu-primary/20' : 'bg-slate-50 hover:bg-slate-100 border-slate-200 text-slate-700 font-medium'`}
            >
              <input
                type="checkbox"
                value={cat.id}
                x-model="selectedCategories"
                class="w-3.5 h-3.5 rounded text-douitsu-primary border-slate-300 focus:ring-douitsu-primary/30 cursor-pointer"
              />
              <span x-show="lang === 'ja'">{cat.label.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{cat.label.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{cat.label.my}</span>
            </label>
          ))}
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- CAREER JOB OPENINGS TABLE (FULL WIDTH)                   -->
    <!-- ======================================================== -->
    <div class="rounded-2xl bg-white border border-slate-200/90 shadow-sm overflow-hidden">
      
      <!-- Responsive Scroll Container -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[720px]">
          
          <!-- Table Head -->
          <thead>
            <tr class="bg-slate-100/90 text-douitsu-navy border-b border-slate-200 text-xs">
              <th scope="col" class="py-3.5 px-3 text-center font-bold w-12 sm:w-14">
                <span x-show="lang === 'ja'">{siteData.career.tableHeaders.no.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.career.tableHeaders.no.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.career.tableHeaders.no.my}</span>
              </th>
              <th scope="col" class="py-3.5 px-4 font-bold">
                <span x-show="lang === 'ja'">{siteData.career.tableHeaders.title.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.career.tableHeaders.title.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.career.tableHeaders.title.my}</span>
              </th>
              <th scope="col" class="py-3.5 px-4 font-bold w-40 sm:w-44">
                <span x-show="lang === 'ja'">{siteData.career.tableHeaders.salary.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.career.tableHeaders.salary.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.career.tableHeaders.salary.my}</span>
              </th>
              <th scope="col" class="py-3.5 px-4 font-bold w-36">
                <span x-show="lang === 'ja'">{siteData.career.tableHeaders.joinDate.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.career.tableHeaders.joinDate.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.career.tableHeaders.joinDate.my}</span>
              </th>
              <th scope="col" class="py-3.5 px-4 font-bold w-28">
                <span x-show="lang === 'ja'">{siteData.career.tableHeaders.ageLimit.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.career.tableHeaders.ageLimit.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.career.tableHeaders.ageLimit.my}</span>
              </th>
              <th scope="col" class="py-3.5 px-3 text-center font-bold w-24">
                <span x-show="lang === 'ja'">求人票</span>
                <span x-show="lang === 'en'" style="display: none;">Flyer</span>
                <span x-show="lang === 'my'" style="display: none;">ပိုစတာ</span>
              </th>
            </tr>
          </thead>

          <!-- Table Body -->
          <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
            {siteData.career.jobs.map((job) => (
              <tr
                x-show={`isMatch(${job.no})`}
                class="hover:bg-douitsu-ice/80 cursor-pointer transition-all duration-150 group"
                @click={`lightboxImg = '${job.image}'; lightboxTitle = (lang === 'ja' ? '${job.title.ja} (求人票)' : (lang === 'en' ? '${job.title.en} (Job Flyer)' : '${job.title.my} (အလုပ်ခေါ် ပိုစတာ)'))`}
                title="クリックして詳細な求人票ポスターを表示"
              >
                <!-- Column 1: No. -->
                <td class="py-3.5 px-3 text-center">
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-douitsu-primary/10 group-hover:bg-douitsu-primary group-hover:text-white text-douitsu-primary font-bold text-xs transition-colors">
                    {job.no}
                  </span>
                </td>

                <!-- Column 2: Job Title with Sector Category Tag -->
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="inline-block px-2 py-0.5 rounded-md bg-slate-100 group-hover:bg-white text-[11px] font-bold text-douitsu-primary border border-slate-200/80 transition-colors shrink-0">
                      <span x-show="lang === 'ja'">{job.categoryLabel.ja}</span>
                      <span x-show="lang === 'en'" style="display: none;">{job.categoryLabel.en}</span>
                      <span x-show="lang === 'my'" style="display: none;">{job.categoryLabel.my}</span>
                    </span>
                    <span class="font-bold text-douitsu-navy group-hover:text-douitsu-primary transition-colors leading-snug">
                      <span x-show="lang === 'ja'">{job.title.ja}</span>
                      <span x-show="lang === 'en'" style="display: none;">{job.title.en}</span>
                      <span x-show="lang === 'my'" style="display: none;">{job.title.my}</span>
                    </span>
                  </div>
                </td>

                <!-- Column 3: Salary (Compact Two-Line Format) -->
                <td class="py-3.5 px-4 shrink-0 whitespace-nowrap">
                  <div class="flex flex-col leading-snug">
                    <!-- Line 1: Starting Pay with Period Pill -->
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <span class="inline-block px-1.5 py-0.5 rounded bg-douitsu-ice text-[10px] font-bold text-douitsu-primary">
                        <span x-show="lang === 'ja'">月給</span>
                        <span x-show="lang === 'en'" style="display: none;">Monthly</span>
                        <span x-show="lang === 'my'" style="display: none;">လစဥ်</span>
                      </span>
                      <span class="font-bold text-douitsu-navy text-xs sm:text-[13px]">
                        <span x-show="lang === 'ja'">{job.salary.line1.ja.replace('月給 ', '')}</span>
                        <span x-show="lang === 'en'" style="display: none;">{job.salary.line1.en}</span>
                        <span x-show="lang === 'my'" style="display: none;">{job.salary.line1.my}</span>
                      </span>
                    </div>
                    <!-- Line 2: Maximum Pay -->
                    <div class="text-xs sm:text-[13px] font-extrabold text-douitsu-primary pl-1">
                      <span class="text-slate-400 font-normal mr-0.5">〜</span>
                      <span x-show="lang === 'ja'">{job.salary.line2.ja}</span>
                      <span x-show="lang === 'en'" style="display: none;">{job.salary.line2.en}</span>
                      <span x-show="lang === 'my'" style="display: none;">{job.salary.line2.my}</span>
                    </div>
                  </div>
                </td>

                <!-- Column 4: Join Date -->
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <span class="inline-block px-2.5 py-1 rounded-md bg-slate-100 group-hover:bg-white text-slate-700 text-xs font-semibold transition-colors">
                    <span x-show="lang === 'ja'">{job.joinDate.ja}</span>
                    <span x-show="lang === 'en'" style="display: none;">{job.joinDate.en}</span>
                    <span x-show="lang === 'my'" style="display: none;">{job.joinDate.my}</span>
                  </span>
                </td>

                <!-- Column 5: Age Limit -->
                <td class="py-3.5 px-4 text-slate-600 font-medium whitespace-nowrap">
                  <span x-show="lang === 'ja'">{job.ageLimit.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{job.ageLimit.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{job.ageLimit.my}</span>
                </td>

                <!-- Column 6: Action Badge / Button -->
                <td class="py-3.5 px-3 text-center whitespace-nowrap">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-douitsu-primary/10 group-hover:bg-douitsu-primary text-douitsu-primary group-hover:text-white font-bold text-xs transition-all shadow-2xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                    <span x-show="lang === 'ja'">表示</span>
                    <span x-show="lang === 'en'" style="display: none;">View</span>
                    <span x-show="lang === 'my'" style="display: none;">ကြည့်မည်</span>
                  </span>
                </td>
              </tr>
            ))}

            <!-- Empty State Row (When search / filters return zero results) -->
            <tr x-show="visibleCount === 0" style="display: none;">
              <td colspan="6" class="py-12 px-6 text-center bg-slate-50/50">
                <div class="max-w-md mx-auto flex flex-col items-center">
                  <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <p class="text-xs sm:text-sm text-slate-600 font-medium mb-3">
                    <span x-show="lang === 'ja'">{siteData.career.filter.noResults.ja}</span>
                    <span x-show="lang === 'en'" style="display: none;">{siteData.career.filter.noResults.en}</span>
                    <span x-show="lang === 'my'" style="display: none;">{siteData.career.filter.noResults.my}</span>
                  </p>
                  <button
                    type="button"
                    @click="resetFilters()"
                    class="px-4 py-1.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white text-xs font-bold transition-all shadow-xs cursor-pointer"
                  >
                    <span x-show="lang === 'ja'">すべての求人を表示</span>
                    <span x-show="lang === 'en'" style="display: none;">Show All Jobs</span>
                    <span x-show="lang === 'my'" style="display: none;">အလုပ်အားလုံး ပြန်ပြရန်</span>
                  </button>
                </div>
              </td>
            </tr>
          </tbody>

        </table>
      </div>

      <!-- Bottom Footer Card inside Table -->
      <div class="px-5 py-4 bg-slate-50/80 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <span class="text-slate-600 font-medium">
          <span x-show="lang === 'ja'">※ 各求人行をクリックすると詳細な求人票ポスターを確認できます。お気軽にお問い合わせください。</span>
          <span x-show="lang === 'en'" style="display: none;">* Click any job row to view the detailed flyer poster. Contact us anytime for inquiries.</span>
          <span x-show="lang === 'my'" style="display: none;">※ အလုပ်အကိုင် အတန်းများကို နှိပ်၍ အသေးစိတ် အလုပ်ခေါ် ပိုစတာကို ကြည့်ရှုနိုင်ပါသည်။ စုံစမ်းမေးမြန်းလိုပါက ဆက်သွယ်နိုင်ပါသည်။</span>
        </span>

        <a
          href="#contact"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white font-bold text-xs shadow-xs transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"></path>
          </svg>
          <span x-show="lang === 'ja'">お問い合わせ・応募する</span>
          <span x-show="lang === 'en'" style="display: none;">Inquire & Apply</span>
          <span x-show="lang === 'my'" style="display: none;">ဆက်သွယ် မေးမြန်းလျှောက်ထားရန်</span>
        </a>
      </div>

    </div>

  </div>
</section>
