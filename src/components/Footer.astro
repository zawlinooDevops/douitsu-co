---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SITE FOOTER                                                  -->
<!-- ID: #footer / フッター                                        -->
<!-- ============================================================ -->
<footer class="bg-douitsu-navy text-slate-300 py-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800/80">
      
      <!-- Brand & Company Info -->
      <div class="flex items-center gap-3">
        <div class="bg-white rounded-xl p-1.5 shadow-xs inline-block">
          <img src="/images/landing/login-logo.jpg" alt="DOUITSU Logo" class="h-8 w-auto object-contain" />
        </div>
        <div>
          <h4 class="font-bold text-white text-base">{siteData.meta.companyName}</h4>
          <p class="text-xs text-slate-400">{siteData.meta.registrationNo}</p>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap items-center justify-center gap-4 text-xs">
        {siteData.navigation.map((item) => (
          <a href={item.href} class="text-slate-400 hover:text-white transition-colors">
            <span x-show="lang === 'ja'">{item.label.ja}</span>
            <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>
          </a>
        ))}
      </nav>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>{siteData.footer.copyright}</p>
      <a href="#home" class="text-slate-400 hover:text-white transition-colors">
        ▲ ページ上部へ
      </a>
    </div>
  </div>
</footer>
