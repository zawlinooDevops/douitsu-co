---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SITE FOOTER                                                  -->
<!-- ID: #footer / フッター                                        -->
<!-- ============================================================ -->
<footer class="bg-douitsu-navy text-slate-300 py-12 border-t border-slate-800 relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-800/80">
      
      <!-- Brand & Company Info -->
      <div class="flex items-center gap-3">
        <div class="bg-white rounded-xl p-1.5 shadow-xs flex items-center justify-center shrink-0 group leading-none">
          <div class="logo-animate-wrapper flex items-center justify-center leading-none">
            <img src="/images/landing/logo-mark.png" alt="DOUITSU Logo" class="h-8 w-auto block object-contain transition-transform duration-300 group-hover:scale-105" />
            <div class="logo-shimmer-mask" aria-hidden="true">
              <div class="logo-shimmer-beam"></div>
            </div>
          </div>
        </div>
        <div>
          <h4 class="font-bold text-white text-base">
            <span x-show="lang === 'ja'">{siteData.meta.companyName}</span>
            <span x-show="lang !== 'ja'" style="display: none;">{siteData.meta.companyNameEn}</span>
          </h4>
          <p class="text-xs text-slate-400">
            <span x-show="lang === 'ja'">登録支援機関: {siteData.meta.registrationNo}</span>
            <span x-show="lang === 'en'" style="display: none;">Registered Support Org: {siteData.meta.registrationNo}</span>
            <span x-show="lang === 'my'" style="display: none;">မှတ်ပုံတင်အမှတ်: {siteData.meta.registrationNo}</span>
          </p>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav aria-label="Footer Navigation" class="flex flex-wrap items-center justify-center gap-4 text-xs">
        {siteData.navigation.map((item) => (
          <a href={item.href} class="text-slate-400 hover:text-white transition-colors">
            <span x-show="lang === 'ja'">{item.label.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{item.label.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>
          </a>
        ))}
      </nav>

    </div>

    <!-- Bottom Copyright & Version -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>Copyright © 2025 DOUITSU LLC. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <a href="#home" class="text-slate-400 hover:text-white transition-colors">
          <span x-show="lang === 'ja'">▲ ページ上部へ</span>
          <span x-show="lang === 'en'" style="display: none;">▲ Back to top</span>
          <span x-show="lang === 'my'" style="display: none;">▲ စာမျက်နှာ ထိပ်ဆုံးသို့</span>
        </a>
        <span class="text-slate-700 select-none" aria-hidden="true">•</span>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-mono text-slate-400 bg-slate-800/80 border border-slate-700/60" title="Site Version">
          v{siteData.meta.version}
        </span>
      </div>
    </div>
  </div>
</footer>
