---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';

const sectors = siteData.sectors.items;
---

<!-- ============================================================ -->
<!-- SECTION: SUPPORTED SECTORS (対応分野)                           -->
<!-- ID: #sectors / 対応分野                                        -->
<!-- ============================================================ -->
<section
  id="sectors"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden scroll-mt-24"
>
  <!-- Ambient Glow Orbs -->
  <div class="absolute -top-20 -right-20 w-80 h-80 bg-douitsu-primary/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-douitsu-sky/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <SectionHeader
      eyebrow={siteData.sectors.eyebrow}
      title={siteData.sectors.title}
    />

    <!-- 4 Sector Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {sectors.map((sector) => (
        <div class="rounded-2xl bg-white border border-slate-200/90 hover:border-douitsu-primary/50 shadow-sm hover:shadow-card transition-all duration-300 flex flex-col justify-between overflow-hidden group hover:-translate-y-1">
          <!-- Top Card Media & Content -->
          <div class="flex-1 flex flex-col">
            <!-- Image / Placeholder Area -->
            <div class="relative w-full aspect-[16/10] bg-slate-50 border-b border-slate-100 flex flex-col items-center justify-center p-4 overflow-hidden group-hover:bg-douitsu-ice/40 transition-colors">
              {sector.image ? (
                <img
                  src={sector.image}
                  alt={sector.alt.ja}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="flex flex-col items-center justify-center text-center select-none py-2">
                  <div class="w-12 h-12 rounded-xl bg-white border border-slate-200/90 shadow-2xs flex items-center justify-center text-douitsu-primary group-hover:scale-110 group-hover:border-douitsu-primary/40 transition-all duration-300 mb-2">
                    {sector.id === 'sector-kaigo' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                      </svg>
                    )}
                    {sector.id === 'sector-building-cleaning' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    )}
                    {sector.id === 'sector-food-service' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 2v3M10 2v3M14 2v3" />
                      </svg>
                    )}
                    {sector.id === 'sector-manufacturing' && (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    )}
                  </div>
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-200/60 text-slate-500 text-[10px] font-medium tracking-wide">
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span x-show="lang === 'ja'">写真準備中</span>
                    <span x-show="lang === 'en'" style="display: none;">Photo Coming Soon</span>
                    <span x-show="lang === 'my'" style="display: none;">ဓာတ်ပုံ ထည့်သွင်းဆဲ</span>
                  </div>
                </div>
              )}
            </div>

            <!-- Image Caption: "イメージ" (ဂျပန်) / "Image" (အင်္ဂလိပ်) / "နမူနာပုံ" (မြန်မာ) -->
            <div class="px-5 pt-2 text-right">
              <span class="text-[10px] sm:text-[11px] text-slate-400 font-normal tracking-wide select-none">
                <span x-show="lang === 'ja'">{siteData.sectors.imageLabel.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.sectors.imageLabel.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.sectors.imageLabel.my}</span>
              </span>
            </div>

            <!-- Card Content (Title & Description) -->
            <div class="p-5 pt-2 flex-1 flex flex-col justify-start">
              <h3 class="text-base sm:text-lg font-bold text-douitsu-navy group-hover:text-douitsu-primary transition-colors leading-snug">
                <span x-show="lang === 'ja'">{sector.title.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{sector.title.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{sector.title.my}</span>
              </h3>
              <p class="text-xs sm:text-sm text-douitsu-slate mt-2 leading-relaxed">
                <span x-show="lang === 'ja'">{sector.description.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{sector.description.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{sector.description.my}</span>
              </p>
            </div>
          </div>

          <!-- Bottom subtle accent bar on hover -->
          <div class="h-1 w-full bg-slate-100 group-hover:bg-gradient-to-r group-hover:from-douitsu-primary group-hover:to-douitsu-sky transition-colors"></div>
        </div>
      ))}
    </div>
  </div>
</section>
