---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<!-- ============================================================ -->
<!-- SECTION: FAQ (よくあるご質問)                                  -->
<!-- ID: #faq / よくあるご質問                                     -->
<!-- ============================================================ -->
<section
  id="faq"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden scroll-mt-24"
>
  <!-- Left Dashed Square Grid Pattern Accent (ဘယ်ဘက် pattern) -->
  <div
    class="absolute left-0 top-1/2 -translate-y-1/2 w-64 sm:w-80 md:w-96 lg:w-[460px] h-80 sm:h-96 md:h-[460px] pointer-events-none overflow-hidden opacity-[0.55] [mask-image:linear-gradient(to_right,black_0%,black_40%,transparent_95%)] [-webkit-mask-image:linear-gradient(to_right,black_0%,black_40%,transparent_95%)]"
    aria-hidden="true"
  >
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="faq-dot-square-left" width="32" height="32" patternUnits="userSpaceOnUse">
          <path
            d="M 32,0 L 0,0 0,32"
            fill="none"
            stroke="#94a3b8"
            stroke-width="1.2"
            stroke-dasharray="3,3"
          />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#faq-dot-square-left)" />
    </svg>
  </div>

  <!-- Right Dashed Square Grid Pattern Accent (ညာဘက် pattern) -->
  <div
    class="absolute right-0 top-1/2 -translate-y-1/2 w-64 sm:w-80 md:w-96 lg:w-[460px] h-80 sm:h-96 md:h-[460px] pointer-events-none overflow-hidden opacity-[0.55] [mask-image:linear-gradient(to_left,black_0%,black_40%,transparent_95%)] [-webkit-mask-image:linear-gradient(to_left,black_0%,black_40%,transparent_95%)]"
    aria-hidden="true"
  >
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="faq-dot-square-right" width="32" height="32" patternUnits="userSpaceOnUse">
          <path
            d="M 32,0 L 0,0 0,32"
            fill="none"
            stroke="#94a3b8"
            stroke-width="1.2"
            stroke-dasharray="3,3"
          />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#faq-dot-square-right)" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <SectionHeader
      eyebrow="FAQ"
      title={siteData.faq.title}
      subtitle={siteData.faq.subtitle}
    />

    <!-- FAQ Interactive Accordion List (5 Items) -->
    <div class="max-w-4xl mx-auto space-y-3.5">
      {siteData.faq.items.map((item, index) => (
        <div
          class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden transition-all duration-200 hover:border-douitsu-primary/40 hover:shadow-sm"
          x-data={`{ isOpen: ${index === 0} }`}
        >
          <!-- Question Trigger Button -->
          <button
            type="button"
            @click="isOpen = !isOpen"
            class="w-full px-5 sm:px-6 py-4 sm:py-5 text-left flex items-center justify-between gap-4 transition-colors select-none"
            :class="{ 'bg-douitsu-ice/40': isOpen }"
            :aria-expanded="isOpen"
          >
            <span class="flex items-center gap-3.5 sm:gap-4 min-w-0">
              <span
                class="flex-shrink-0 w-8 h-8 rounded-lg font-mono font-bold text-xs flex items-center justify-center transition-all"
                :class="isOpen ? 'bg-douitsu-primary text-white shadow-xs' : 'bg-slate-100 text-slate-600'"
              >
                Q{index + 1}
              </span>
              <span class="font-bold text-sm sm:text-base text-douitsu-navy leading-normal sm:leading-snug">
                <span x-show="lang === 'ja'">{item.question.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{item.question.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{item.question.my}</span>
              </span>
            </span>
            <!-- Toggle Chevron Icon -->
            <span
              class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-slate-400 transition-transform duration-200"
              :class="{ 'rotate-180 text-douitsu-primary bg-douitsu-primary/10': isOpen }"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>

          <!-- Answer Content Panel -->
          <div
            x-show="isOpen"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-1"
            class="px-5 sm:px-6 pb-5 sm:pb-6 pt-3 text-sm text-slate-600 leading-relaxed border-t border-slate-100"
            style={index === 0 ? "" : "display: none;"}
          >
            <div class="flex items-start gap-3.5 pl-0 sm:pl-1">
              <span class="flex-shrink-0 font-mono font-extrabold text-xs text-douitsu-primary bg-douitsu-primary/10 px-2 py-0.5 rounded mt-0.5">
                A
              </span>
              <p class="font-medium text-slate-700 leading-relaxed text-sm sm:text-[15px]">
                <span x-show="lang === 'ja'">{item.answer.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{item.answer.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{item.answer.my}</span>
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
