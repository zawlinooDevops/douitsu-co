---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: FEATURED COMPANY INFO & PDF DOWNLOADS               -->
<!-- ID: #section_featured / 企業情報 & 介護テキスト (Company & Docs)-->
<!-- ============================================================ -->
<section
  id="section_featured"
  class="py-20 bg-slate-100 border-b border-slate-200/60 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Card: Company Profile (企業情報) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="h-full rounded-3xl bg-white border border-slate-200 p-7 sm:p-9 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 p-2 flex items-center justify-center">
                  <img src="/images/landing/login-logo.jpg" alt="Logo" class="max-h-full max-w-full object-contain" />
                </div>
                <div>
                  <span class="text-xs font-bold text-douitsu-primary uppercase tracking-wider">
                    <span x-show="lang === 'ja'">{siteData.featured.company.badge.ja}</span>
                    <span x-show="lang === 'my'" style="display: none;">{siteData.featured.company.badge.my}</span>
                  </span>
                  <h3 class="text-2xl font-extrabold text-douitsu-navy">
                    <span x-show="lang === 'ja'">{siteData.featured.company.title.ja}</span>
                    <span x-show="lang === 'my'" style="display: none;">{siteData.featured.company.title.my}</span>
                  </h3>
                </div>
              </div>
              <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                法人登録済
              </span>
            </div>

            <dl class="divide-y divide-slate-100 text-sm">
              {siteData.featured.company.items.map((item) => (
                <div class="py-3.5 grid grid-cols-3 sm:grid-cols-4 gap-2">
                  <dt class="font-bold text-slate-500">
                    <span x-show="lang === 'ja'">{item.label.ja}</span>
                    <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>
                  </dt>
                  <dd class="col-span-2 sm:col-span-3 font-semibold text-douitsu-navy">
                    {item.label.ja === '電話番号' ? (
                      <a href={`tel:${siteData.meta.phone}`} class="text-douitsu-primary hover:underline font-bold">
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span>出入国在留管理庁 登録支援機関許可済</span>
            <span class="font-mono font-semibold text-slate-700">DOUITSU LLC</span>
          </div>
        </div>
      </div>

      <!-- Right Card: Kaigo PDF Textbooks (Download PDF) -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="h-full rounded-3xl bg-white border border-slate-200 p-7 sm:p-9 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="pb-6 mb-6 border-b border-slate-100">
              <span class="text-xs font-bold text-pink-600 uppercase tracking-wider">
                <span x-show="lang === 'ja'">{siteData.featured.downloads.badge.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.featured.downloads.badge.my}</span>
              </span>
              <h3 class="text-2xl font-extrabold text-douitsu-navy mt-1">
                <span x-show="lang === 'ja'">{siteData.featured.downloads.title.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.featured.downloads.title.my}</span>
              </h3>
              <p class="text-xs text-slate-500 mt-1">
                <span x-show="lang === 'ja'">{siteData.featured.downloads.subtitle.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.featured.downloads.subtitle.my}</span>
              </p>
            </div>

            <!-- Download Item Cards -->
            <div class="flex flex-col gap-4">
              {siteData.featured.downloads.files.map((file) => (
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-douitsu-primary/50 transition-all flex flex-col gap-3 group">
                  <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0 font-bold text-xs shadow-sm">
                      PDF
                    </div>
                    <div class="flex-1">
                      <h4 class="text-sm font-bold text-douitsu-navy group-hover:text-douitsu-primary transition-colors leading-snug">
                        <span x-show="lang === 'ja'">{file.title.ja}</span>
                        <span x-show="lang === 'my'" style="display: none;">{file.title.my}</span>
                      </h4>
                      <div class="flex items-center gap-2 mt-1 text-xs text-slate-500">
                        <span class="font-medium text-slate-600">{file.lang}</span>
                        <span>•</span>
                        <span>{file.size}</span>
                      </div>
                    </div>
                  </div>

                  <a
                    href={file.href}
                    download
                    class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-douitsu-primary hover:text-white border border-slate-200 text-slate-700 text-xs font-bold shadow-sm transition-all"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>ダウンロード (PDF)</span>
                  </a>
                </div>
              ))}
            </div>
          </div>

          <p class="mt-6 text-[11px] text-slate-400 text-center">
            ※ 介護特定技能評価試験の学習・対策にどなたでも無料でご利用いただけます。
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
