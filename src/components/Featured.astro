---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<!-- ============================================================ -->
<!-- SECTION: ABOUT US / COMPANY PROFILE (会社概要 & DOWNLOAD PDF)  -->
<!-- ID: #about (Alias: #company, #featured) / 会社概要 & 介護テキスト -->
<!-- ============================================================ -->
<section
  id="about"
  class="py-16 md:py-24 bg-slate-100 border-b border-slate-200/60 relative scroll-mt-24"
>
  <div id="company" class="absolute -top-24"></div>
  <div id="featured" class="absolute -top-24"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <SectionHeader
      eyebrow="ABOUT US"
      title={siteData.featured.title}
      subtitle={siteData.featured.subtitle}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Card: Company Profile (企業情報) -->
      <div class="lg:col-span-6 flex flex-col">
        <div class="h-full rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="pb-5 mb-5 border-b border-slate-100">
              <h3 class="text-xl font-bold text-douitsu-navy">
                <span x-show="lang === 'ja'">基本情報</span>
                <span x-show="lang === 'en'" style="display: none;">Corporate Info</span>
                <span x-show="lang === 'my'" style="display: none;">အခြေခံအချက်အလက်</span>
              </h3>
            </div>

            <dl class="divide-y divide-slate-100 text-sm">
              {siteData.featured.company.items.map((item) => (
                <div class="py-3 grid grid-cols-3 sm:grid-cols-4 gap-2">
                  <dt class="font-bold text-slate-500">
                    <span x-show="lang === 'ja'">{item.label.ja}</span>
                    <span x-show="lang === 'en'" style="display: none;">{item.label.en}</span>
                    <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>
                  </dt>
                  <dd class="col-span-2 sm:col-span-3 font-semibold text-douitsu-navy">
                    {typeof item.value === 'object' ? (
                      <>
                        <span x-show="lang === 'ja'">{item.value.ja}</span>
                        <span x-show="lang === 'en'" style="display: none;">{item.value.en}</span>
                        <span x-show="lang === 'my'" style="display: none;">{item.value.my}</span>
                      </>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>

      <!-- Right Card: Kaigo PDF Textbooks (Download PDF) -->
      <div class="lg:col-span-6 flex flex-col">
        <div class="h-full rounded-2xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="pb-5 mb-5 border-b border-slate-100">
              <h3 class="text-2xl font-extrabold text-douitsu-navy">
                <span x-show="lang === 'ja'">{siteData.featured.downloads.title.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.featured.downloads.title.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.featured.downloads.title.my}</span>
              </h3>
            </div>

            <!-- Download Item Cards -->
            <div class="flex flex-col gap-4">
              {siteData.featured.downloads.files.map((file) => (
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 hover:border-douitsu-primary/50 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                  <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-lg bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0 font-bold text-xs shadow-xs">
                      PDF
                    </div>
                    <div>
                      <h4 class="text-sm font-bold text-douitsu-navy leading-snug">
                        <span x-show="lang === 'ja'">{file.title.ja}</span>
                        <span x-show="lang === 'en'" style="display: none;">{file.title.en}</span>
                        <span x-show="lang === 'my'" style="display: none;">{file.title.my}</span>
                      </h4>
                      <div class="flex items-center gap-2 mt-1 text-xs text-slate-500">
                        <span class="font-medium text-slate-600">{file.lang}</span>
                        <span>•</span>
                        <span>{file.size}</span>
                      </div>
                    </div>
                  </div>

                  <a
                    href={file.href}
                    download
                    class="w-full sm:w-auto flex-shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg bg-douitsu-primary hover:bg-douitsu-blue text-white text-xs font-bold shadow-xs transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>Download</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
