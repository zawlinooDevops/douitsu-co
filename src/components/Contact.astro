---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFYQzIK4TKPrb3od';
---

<!-- Cloudflare Turnstile API Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<!-- ============================================================ -->
<!-- SECTION: CONTACT & INQUIRIES                                 -->
<!-- ID: #contact (Alias: #section_4) / お問い合わせ                 -->
<!-- ============================================================ -->
<section
  id="contact"
  class="py-20 md:py-28 bg-douitsu-ice relative overflow-hidden scroll-mt-24"
  x-data={`{
    formSubmitted: false,
    isSubmitting: false,
    errorMessage: '',
    renderedAt: Date.now(),
    formData: {
      name: '',
      email: '',
      phone: '',
      message: '',
      website: '' // Field Honeypot
    },
    fieldErrors: {
      name: '',
      email: '',
      phone: '',
      message: ''
    },
    messages: {
      required: {
        ja: "${siteData.contact.form.requiredError.ja}",
        en: "${siteData.contact.form.requiredError.en}",
        my: "${siteData.contact.form.requiredError.my}"
      },
      name: {
        ja: "${siteData.contact.form.nameError.ja}",
        en: "${siteData.contact.form.nameError.en}",
        my: "${siteData.contact.form.nameError.my}"
      },
      email: {
        ja: "${siteData.contact.form.emailError.ja}",
        en: "${siteData.contact.form.emailError.en}",
        my: "${siteData.contact.form.emailError.my}"
      },
      phone: {
        ja: "${siteData.contact.form.phoneError.ja}",
        en: "${siteData.contact.form.phoneError.en}",
        my: "${siteData.contact.form.phoneError.my}"
      },
      message: {
        ja: "${siteData.contact.form.messageError.ja}",
        en: "${siteData.contact.form.messageError.en}",
        my: "${siteData.contact.form.messageError.my}"
      },
      captcha: {
        ja: "${siteData.contact.form.captchaError.ja}",
        en: "${siteData.contact.form.captchaError.en}",
        my: "${siteData.contact.form.captchaError.my}"
      },
      general: {
        ja: "${siteData.contact.form.error.ja}",
        en: "${siteData.contact.form.error.en}",
        my: "${siteData.contact.form.error.my}"
      }
    },
    getMsg(type) {
      const activeLang = typeof lang !== 'undefined' ? lang : 'ja';
      return (this.messages[type] && this.messages[type][activeLang]) || (this.messages[type] && this.messages[type].ja) || '';
    },
    validateField(field) {
      if (field === 'name') {
        const val = (this.formData.name || '').trim();
        if (!val) {
          this.fieldErrors.name = this.getMsg('required');
        } else if (val.length < 2 || val.length > 100) {
          this.fieldErrors.name = this.getMsg('name');
        } else {
          this.fieldErrors.name = '';
        }
      }
      if (field === 'email') {
        const val = (this.formData.email || '').trim();
        const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;
        if (!val) {
          this.fieldErrors.email = this.getMsg('required');
        } else if (!emailRegex.test(val) || val.length > 254) {
          this.fieldErrors.email = this.getMsg('email');
        } else {
          this.fieldErrors.email = '';
        }
      }
      if (field === 'phone') {
        const val = (this.formData.phone || '').trim();
        const phoneRegex = /^[0-9+\\-()\\s]{8,20}$/;
        const digits = val.replace(/[^0-9]/g, '');
        if (!val) {
          this.fieldErrors.phone = this.getMsg('required');
        } else if (!phoneRegex.test(val) || digits.length < 8) {
          this.fieldErrors.phone = this.getMsg('phone');
        } else {
          this.fieldErrors.phone = '';
        }
      }
      if (field === 'message') {
        const val = (this.formData.message || '').trim();
        if (!val) {
          this.fieldErrors.message = this.getMsg('required');
        } else if (val.length < 10) {
          this.fieldErrors.message = this.getMsg('message');
        } else {
          this.fieldErrors.message = '';
        }
      }
    },
    validateAll() {
      this.validateField('name');
      this.validateField('email');
      this.validateField('phone');
      this.validateField('message');
      return !this.fieldErrors.name && !this.fieldErrors.email && !this.fieldErrors.phone && !this.fieldErrors.message;
    },
    resetForm() {
      this.formSubmitted = false;
      this.isSubmitting = false;
      this.errorMessage = '';
      this.renderedAt = Date.now();
      this.formData = { name: '', email: '', phone: '', message: '', website: '' };
      this.fieldErrors = { name: '', email: '', phone: '', message: '' };
      if (typeof window !== 'undefined' && window.turnstile) {
        try { window.turnstile.reset(); } catch (e) { /* ignore */ }
      }
    },
    async submitForm() {
      this.errorMessage = '';

      // Frontend Hostname Security Gate (Strictly douitsu-co.com & www.douitsu-co.com)
      const allowedHosts = ['douitsu-co.com', 'www.douitsu-co.com'];
      if (typeof window !== 'undefined' && !allowedHosts.includes(window.location.hostname)) {
        this.errorMessage = this.getMsg('general');
        return;
      }

      if (!this.validateAll()) {
        return;
      }

      // Retrieve Turnstile CAPTCHA response
      let turnstileToken = '';
      const turnstileInput = document.querySelector('[name=cf-turnstile-response]');
      if (turnstileInput && turnstileInput.value) {
        turnstileToken = turnstileInput.value;
      } else if (typeof window !== 'undefined' && window.turnstile && typeof window.turnstile.getResponse === 'function') {
        turnstileToken = window.turnstile.getResponse() || '';
      }

      if (!turnstileToken) {
        this.errorMessage = this.getMsg('captcha');
        return;
      }

      this.isSubmitting = true;

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            name: this.formData.name,
            email: this.formData.email,
            phone: this.formData.phone,
            message: this.formData.message,
            website: this.formData.website,
            renderedAt: this.renderedAt,
            turnstileToken: turnstileToken
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          this.formSubmitted = true;
          this.formData = { name: '', email: '', phone: '', message: '', website: '' };
          this.fieldErrors = { name: '', email: '', phone: '', message: '' };
          if (typeof window !== 'undefined' && window.turnstile) {
            try { window.turnstile.reset(); } catch (e) { /* ignore */ }
          }
        } else {
          this.errorMessage = result.message || this.getMsg('general');
          if (typeof window !== 'undefined' && window.turnstile) {
            try { window.turnstile.reset(); } catch (e) { /* ignore */ }
          }
        }
      } catch (err) {
        this.errorMessage = this.getMsg('general');
        if (typeof window !== 'undefined' && window.turnstile) {
          try { window.turnstile.reset(); } catch (e) { /* ignore */ }
        }
      } finally {
        this.isSubmitting = false;
      }
    }
  }`}
>
  <div id="section_4" class="absolute -top-24"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <SectionHeader
      eyebrow="CONTACT"
      title={siteData.contact.title}
      subtitle={siteData.contact.subtitle}
    />

    <!-- Contact Grid: Left Office Info + Right Clean Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Office Details -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="p-7 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex flex-col gap-6">
          
          <div>
            <h4 class="text-lg font-extrabold text-douitsu-navy leading-normal sm:leading-snug">
              <span x-show="lang === 'ja'">{siteData.meta.companyName}</span>
              <span x-show="lang !== 'ja'" style="display: none;">{siteData.meta.companyNameEn}</span>
            </h4>
            <p class="text-xs text-slate-500 font-medium mt-0.5">
              <span x-show="lang === 'ja'">{siteData.meta.companyNameEn}</span>
              <span x-show="lang !== 'ja'" style="display: none;">{siteData.meta.companyName}</span>
            </p>
          </div>

          <!-- Address -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.address.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.address.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.address.label.my}</span>
              </span>
              <p class="text-sm font-semibold text-slate-800 leading-normal sm:leading-snug">
                <span x-show="lang === 'ja'">{siteData.contact.address.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.address.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.address.my}</span>
              </p>
            </div>
          </div>

          <!-- Phone -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.phone.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.phone.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.phone.label.my}</span>
              </span>
              <a href={`tel:${siteData.contact.phone.tel || siteData.contact.phone.value}`} class="text-base font-bold text-douitsu-primary hover:underline">
                {siteData.contact.phone.value}
              </a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.email.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.email.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.email.label.my}</span>
              </span>
              <a href={`mailto:${siteData.contact.email.value}`} class="text-sm font-bold text-douitsu-navy hover:underline">
                {siteData.contact.email.value}
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Clean Contact Form -->
      <div class="lg:col-span-7">
        <div class="p-7 sm:p-9 rounded-2xl bg-white border border-slate-200/80 shadow-sm relative">
          
          <!-- Success State -->
          <div
            x-show="formSubmitted"
            x-cloak
            class="text-center py-10"
          >
            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h4 class="text-lg font-bold text-douitsu-navy mb-2 leading-normal sm:leading-snug">
              <span x-show="lang === 'ja'">{siteData.contact.form.success.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.success.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.success.my}</span>
            </h4>
            <button
              type="button"
              @click="resetForm()"
              class="mt-4 px-5 py-2.5 rounded-xl bg-douitsu-primary/10 hover:bg-douitsu-primary/20 text-douitsu-primary text-xs font-bold transition-colors cursor-pointer"
            >
              <span x-show="lang === 'ja'">もう一度送信する</span>
              <span x-show="lang === 'en'" style="display: none;">Send another message</span>
              <span x-show="lang === 'my'" style="display: none;">ထပ်မံပေးပို့ရန်</span>
            </button>
          </div>

          <!-- Form Inputs -->
          <form
            x-show="!formSubmitted"
            @submit.prevent="submitForm()"
            class="space-y-4"
            novalidate
          >
            <!-- Field Honeypot (Hidden from human visitors, traps spam bots) -->
            <div style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;" aria-hidden="true">
              <label for="form-hp-website">Website</label>
              <input
                id="form-hp-website"
                type="text"
                name="website"
                x-model="formData.website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <!-- Global Error Banner (Turnstile / Network / System errors) -->
            <div
              x-show="errorMessage"
              x-cloak
              class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-2.5"
            >
              <svg class="w-4 h-4 flex-shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span x-text="errorMessage"></span>
            </div>

            <!-- Name -->
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 mb-1.5">
                <span x-show="lang === 'ja'">{siteData.contact.form.name.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.name.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.name.label.my}</span>
                <span class="text-red-500">*</span>
              </label>
              <input
                id="contact-name"
                type="text"
                x-model="formData.name"
                @blur="validateField('name')"
                @input="if (fieldErrors.name) validateField('name')"
                :disabled="isSubmitting"
                required
                :placeholder={`lang === 'ja' ? '${siteData.contact.form.name.placeholder.ja}' : (lang === 'en' ? '${siteData.contact.form.name.placeholder.en}' : '${siteData.contact.form.name.placeholder.my}')`}
                class="w-full px-4 py-2.5 sm:py-3 rounded-xl border bg-slate-50/80 hover:bg-white focus:bg-white text-slate-800 text-base sm:text-sm placeholder:text-slate-400 shadow-2xs outline-none transition-all duration-200 disabled:bg-slate-100 disabled:cursor-not-allowed"
                :class="{ 'border-rose-400 ring-4 ring-rose-500/15 bg-rose-50/30': fieldErrors.name, 'border-slate-200 focus:border-douitsu-primary focus:ring-4 focus:ring-douitsu-primary/15': !fieldErrors.name }"
              />
              <p x-show="fieldErrors.name" x-text="fieldErrors.name" class="mt-1 text-xs font-semibold text-rose-600" x-cloak></p>
            </div>

            <!-- Email & Phone Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-email" class="block text-xs font-bold text-slate-700 mb-1.5">
                  <span x-show="lang === 'ja'">{siteData.contact.form.email.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.email.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.email.label.my}</span>
                  <span class="text-red-500">*</span>
                </label>
                <input
                  id="contact-email"
                  type="email"
                  x-model="formData.email"
                  @blur="validateField('email')"
                  @input="if (fieldErrors.email) validateField('email')"
                  :disabled="isSubmitting"
                  required
                  :placeholder={`lang === 'ja' ? '${siteData.contact.form.email.placeholder.ja}' : (lang === 'en' ? '${siteData.contact.form.email.placeholder.en}' : '${siteData.contact.form.email.placeholder.my}')`}
                  class="w-full px-4 py-2.5 sm:py-3 rounded-xl border bg-slate-50/80 hover:bg-white focus:bg-white text-slate-800 text-base sm:text-sm placeholder:text-slate-400 shadow-2xs outline-none transition-all duration-200 disabled:bg-slate-100 disabled:cursor-not-allowed"
                  :class="{ 'border-rose-400 ring-4 ring-rose-500/15 bg-rose-50/30': fieldErrors.email, 'border-slate-200 focus:border-douitsu-primary focus:ring-4 focus:ring-douitsu-primary/15': !fieldErrors.email }"
                />
                <p x-show="fieldErrors.email" x-text="fieldErrors.email" class="mt-1 text-xs font-semibold text-rose-600" x-cloak></p>
              </div>

              <div>
                <label for="contact-phone" class="block text-xs font-bold text-slate-700 mb-1.5">
                  <span x-show="lang === 'ja'">{siteData.contact.form.phone.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.phone.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.phone.label.my}</span>
                  <span class="text-red-500">*</span>
                </label>
                <input
                  id="contact-phone"
                  type="tel"
                  x-model="formData.phone"
                  @blur="validateField('phone')"
                  @input="if (fieldErrors.phone) validateField('phone')"
                  :disabled="isSubmitting"
                  required
                  :placeholder={`lang === 'ja' ? '${siteData.contact.form.phone.placeholder.ja}' : (lang === 'en' ? '${siteData.contact.form.phone.placeholder.en}' : '${siteData.contact.form.phone.placeholder.my}')`}
                  class="w-full px-4 py-2.5 sm:py-3 rounded-xl border bg-slate-50/80 hover:bg-white focus:bg-white text-slate-800 text-base sm:text-sm placeholder:text-slate-400 shadow-2xs outline-none transition-all duration-200 disabled:bg-slate-100 disabled:cursor-not-allowed"
                  :class="{ 'border-rose-400 ring-4 ring-rose-500/15 bg-rose-50/30': fieldErrors.phone, 'border-slate-200 focus:border-douitsu-primary focus:ring-4 focus:ring-douitsu-primary/15': !fieldErrors.phone }"
                />
                <p x-show="fieldErrors.phone" x-text="fieldErrors.phone" class="mt-1 text-xs font-semibold text-rose-600" x-cloak></p>
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-700 mb-1.5">
                <span x-show="lang === 'ja'">{siteData.contact.form.message.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.message.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.message.label.my}</span>
                <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                x-model="formData.message"
                @blur="validateField('message')"
                @input="if (fieldErrors.message) validateField('message')"
                :disabled="isSubmitting"
                rows="4"
                :placeholder={`lang === 'ja' ? '${siteData.contact.form.message.placeholder.ja}' : (lang === 'en' ? '${siteData.contact.form.message.placeholder.en}' : '${siteData.contact.form.message.placeholder.my}')`}
                class="w-full px-4 py-2.5 sm:py-3 rounded-xl border bg-slate-50/80 hover:bg-white focus:bg-white text-slate-800 text-base sm:text-sm placeholder:text-slate-400 shadow-2xs outline-none transition-all duration-200 resize-y disabled:bg-slate-100 disabled:cursor-not-allowed"
                :class="{ 'border-rose-400 ring-4 ring-rose-500/15 bg-rose-50/30': fieldErrors.message, 'border-slate-200 focus:border-douitsu-primary focus:ring-4 focus:ring-douitsu-primary/15': !fieldErrors.message }"
              ></textarea>
              <p x-show="fieldErrors.message" x-text="fieldErrors.message" class="mt-1 text-xs font-semibold text-rose-600" x-cloak></p>
            </div>

            <!-- Cloudflare Turnstile CAPTCHA Widget (Canonical spin/prompt.md: action="contact") -->
            <div class="py-2 flex justify-center">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action="contact"
                data-theme="light"
              ></div>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button
                type="submit"
                :disabled="isSubmitting"
                class="w-full py-3.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue active:scale-[0.99] text-white font-bold text-sm shadow-md hover:shadow-lg focus:ring-4 focus:ring-douitsu-primary/20 outline-none transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <!-- Loading Spinner -->
                <svg
                  x-show="isSubmitting"
                  x-cloak
                  class="animate-spin -ml-1 mr-2 h-4 w-4 text-white"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>

                <!-- Sending Label -->
                <span x-show="isSubmitting" x-cloak>
                  <span x-show="lang === 'ja'">{siteData.contact.form.sending.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.sending.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.sending.my}</span>
                </span>

                <!-- Default Submit Label & Icon -->
                <span x-show="!isSubmitting" class="flex items-center gap-2">
                  <span x-show="lang === 'ja'">{siteData.contact.form.submit.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.submit.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.submit.my}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </span>
              </button>
            </div>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>
