---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<!-- ============================================================ -->
<!-- SECTION: CONTACT & INQUIRIES                                 -->
<!-- ID: #contact (Alias: #section_4) / お問い合わせ                 -->
<!-- ============================================================ -->
<section
  id="contact"
  class="py-20 md:py-28 bg-gradient-to-b from-white via-slate-50/50 to-douitsu-ice/30 relative overflow-hidden scroll-mt-24"
  x-data="{
    formSubmitted: false,
    formData: {
      name: '',
      email: '',
      phone: '',
      message: ''
    },
    submitForm() {
      if (!this.formData.name || !this.formData.email || !this.formData.phone) {
        alert(lang === 'ja' ? '必須項目をすべて入力してください。' : (lang === 'en' ? 'Please fill in all required fields.' : 'လိုအပ်သော အချက်အလက်များ အားလုံး ဖြည့်သွင်းပေးပါ။'));
        return;
      }
      this.formSubmitted = true;
    }
  }"
>
  <div id="section_4" class="absolute -top-24"></div>

  <!-- Background Pattern: Topographic Coordinates Matrix -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-[0.035]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="contact-coords" width="36" height="36" patternUnits="userSpaceOnUse">
          <path d="M 18,14 L 18,22 M 14,18 L 22,18" stroke="#105c8e" stroke-width="1" />
          <circle cx="18" cy="18" r="1" fill="#105c8e" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#contact-coords)" />
    </svg>
  </div>



  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <SectionHeader
      eyebrow="CONTACT US"
      title={siteData.contact.title}
      subtitle={siteData.contact.subtitle}
    />

    <!-- Contact Grid: Left Office Info + Right Clean Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Office Details -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200 shadow-sm flex flex-col gap-6">
          
          <div>
            <h4 class="text-lg font-extrabold text-douitsu-navy">
              <span x-show="lang === 'ja'">{siteData.meta.companyName}</span>
              <span x-show="lang !== 'ja'" style="display: none;">{siteData.meta.companyNameEn}</span>
            </h4>
            <p class="text-xs text-slate-500 font-medium mt-0.5">
              <span x-show="lang === 'ja'">{siteData.meta.companyNameEn}</span>
              <span x-show="lang !== 'ja'" style="display: none;">{siteData.meta.companyName}</span>
            </p>
          </div>

          <!-- Address -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.address.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.address.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.address.label.my}</span>
              </span>
              <p class="text-sm font-semibold text-slate-800 leading-snug">
                <span x-show="lang === 'ja'">{siteData.contact.address.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.address.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.address.my}</span>
              </p>
            </div>
          </div>

          <!-- Phone -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.phone.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.phone.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.phone.label.my}</span>
              </span>
              <a href={`tel:${siteData.contact.phone.tel || siteData.contact.phone.value}`} class="text-base font-bold text-douitsu-primary hover:underline">
                {siteData.contact.phone.value}
              </a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 pt-4 border-t border-slate-200/80">
            <div class="w-10 h-10 rounded-xl bg-douitsu-primary/10 border border-douitsu-primary/15 text-douitsu-primary flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 block mb-0.5">
                <span x-show="lang === 'ja'">{siteData.contact.email.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.email.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.email.label.my}</span>
              </span>
              <a href={`mailto:${siteData.contact.email.value}`} class="text-sm font-bold text-douitsu-navy hover:underline">
                {siteData.contact.email.value}
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Clean Contact Form -->
      <div class="lg:col-span-7">
        <div class="p-7 sm:p-9 rounded-2xl bg-slate-50 border border-slate-200 shadow-sm relative">
          
          <!-- Success State -->
          <div
            x-show="formSubmitted"
            x-cloak
            class="text-center py-10"
          >
            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h4 class="text-lg font-bold text-douitsu-navy mb-2">
              <span x-show="lang === 'ja'">{siteData.contact.form.success.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.success.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.success.my}</span>
            </h4>
            <button
              type="button"
              @click="formSubmitted = false; formData = { name: '', email: '', phone: '', message: '' }"
              class="mt-4 px-5 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold transition-colors"
            >
              <span x-show="lang === 'ja'">もう一度送信する</span>
              <span x-show="lang === 'en'" style="display: none;">Send another message</span>
              <span x-show="lang === 'my'" style="display: none;">ထပ်မံပေးပို့ရန်</span>
            </button>
          </div>

          <!-- Form Inputs -->
          <form
            x-show="!formSubmitted"
            @submit.prevent="submitForm()"
            class="space-y-4"
          >
            <!-- Name -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                <span x-show="lang === 'ja'">{siteData.contact.form.name.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.name.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.name.label.my}</span>
                <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                x-model="formData.name"
                required
                :placeholder="lang === 'ja' ? 'お名前を入力してください' : (lang === 'en' ? 'Enter your full name' : 'အမည်')"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm focus:ring-2 focus:ring-douitsu-primary focus:border-douitsu-primary outline-none transition-all"
              />
            </div>

            <!-- Email & Phone Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  <span x-show="lang === 'ja'">{siteData.contact.form.email.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.email.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.email.label.my}</span>
                  <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  x-model="formData.email"
                  required
                  :placeholder="lang === 'ja' ? 'メールアドレスを入力してください' : (lang === 'en' ? 'Enter your email address' : 'အီးမေးလ်')"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm focus:ring-2 focus:ring-douitsu-primary focus:border-douitsu-primary outline-none transition-all"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  <span x-show="lang === 'ja'">{siteData.contact.form.phone.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.phone.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.phone.label.my}</span>
                  <span class="text-red-500">*</span>
                </label>
                <input
                  type="tel"
                  x-model="formData.phone"
                  required
                  :placeholder="lang === 'ja' ? '電話番号を入力してください' : (lang === 'en' ? 'Enter your phone number' : 'ဖုန်းနံပါတ်')"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm focus:ring-2 focus:ring-douitsu-primary focus:border-douitsu-primary outline-none transition-all"
                />
              </div>
            </div>

            <!-- Message -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                <span x-show="lang === 'ja'">{siteData.contact.form.message.label.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.message.label.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.message.label.my}</span>
              </label>
              <textarea
                x-model="formData.message"
                rows="4"
                :placeholder="lang === 'ja' ? 'ご相談・お問い合わせ内容をご記入ください' : (lang === 'en' ? 'Enter your message or inquiry' : 'မေးမြန်းလိုသော အကြောင်းအရာ')"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm focus:ring-2 focus:ring-douitsu-primary focus:border-douitsu-primary outline-none transition-all resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button
                type="submit"
                class="w-full py-3 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2"
              >
                <span x-show="lang === 'ja'">{siteData.contact.form.submit.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{siteData.contact.form.submit.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{siteData.contact.form.submit.my}</span>
              </button>
            </div>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>
