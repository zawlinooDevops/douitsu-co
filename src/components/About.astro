---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: SUPPORT (SUPPORT PLAN & 10 PILLARS)                  -->
<!-- ID: #support (Alias: #section_2) / 私たちが全力で支援します    -->
<!-- ============================================================ -->
<section
  id="support"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden"
>
  <div id="section_2" class="absolute -top-24"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-douitsu-navy tracking-tight mb-3">
        <span x-show="lang === 'ja'">{siteData.about.title.ja}</span>
        <span x-show="lang === 'en'" style="display: none;">{siteData.about.title.en}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.about.title.my}</span>
      </h2>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mt-2">
        <span x-show="lang === 'ja'">{siteData.about.lead.ja}</span>
        <span x-show="lang === 'en'" style="display: none;">{siteData.about.lead.en}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.about.lead.my}</span>
      </p>
    </div>

    <!-- Main Grid: Poster Image & 10 Support Pillars List -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: About Main Poster -->
      <div class="lg:col-span-5 flex justify-center">
        <div
          class="relative w-full max-w-md rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-white group cursor-pointer"
          @click={`lightboxImg = '/images/landing/about-main.png'; lightboxTitle = (lang === 'ja' ? '特定技能 支援活動' : (lang === 'en' ? 'Specified Skilled Worker Support Gallery' : 'သတ်မှတ်ကျွမ်းကျင်လုပ်သား ထောက်ပံ့မှု မှတ်တမ်း'))`}
        >
          <img
            src="/images/landing/about-main.png"
            alt="DOUITSU 支援活動"
            class="w-full h-auto object-contain transition-transform duration-500 group-hover:scale-102"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/20 transition-colors flex items-center justify-center">
            <span class="opacity-0 group-hover:opacity-100 transition-opacity px-4 py-2 bg-white/95 rounded-xl text-xs font-bold text-slate-800 shadow-md">
              <span x-show="lang === 'ja'">拡大表示</span>
              <span x-show="lang === 'en'" style="display: none;">Zoom In</span>
              <span x-show="lang === 'my'" style="display: none;">အကြီးချဲ့ရန်</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: 10 Core Support Items -->
      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {siteData.about.pillars.map((pillar) => (
            <div class="p-4 rounded-xl bg-slate-50 hover:bg-white border border-slate-200/80 hover:border-douitsu-primary/50 shadow-xs hover:shadow-sm transition-all flex items-center gap-3.5 group">
              <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-douitsu-blue group-hover:bg-douitsu-primary text-white font-mono font-bold text-xs flex items-center justify-center transition-colors">
                {pillar.number}
              </span>
              <span class="font-bold text-sm text-douitsu-navy group-hover:text-douitsu-primary transition-colors leading-snug">
                <span x-show="lang === 'ja'">{pillar.title.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{pillar.title.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{pillar.title.my}</span>
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
