---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SUBPAGE HEADER & NAVIGATION (TWO-TIER: TOP BAR + BACK NAVBAR)-->
<!-- ============================================================ -->
<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- 1. TOP INFO BAR -->
  <div class="bg-douitsu-navy text-slate-200 text-xs py-1.5 sm:py-2 border-b border-white/10 shadow-xs relative z-20">
    <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 flex items-center justify-between gap-1 sm:gap-2">
      
      <!-- Left: Tel (Always visible) & Email (sm+) -->
      <div class="flex items-center gap-3 sm:gap-6 text-slate-300 text-xs shrink-0">
        <!-- Phone (Tel) -->
        <a
          href={`tel:${siteData.meta.phoneTel || siteData.meta.phone}`}
          class="inline-flex items-center gap-1 sm:gap-1.5 font-semibold text-slate-200 hover:text-white transition-colors text-xs tracking-tight sm:tracking-wide"
        >
          <svg class="w-3.5 h-3.5 text-douitsu-sky shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>{siteData.meta.phone}</span>
        </a>

        <!-- Email (Hidden on mobile < sm, visible on tablet/desktop sm+) -->
        <a
          href={`mailto:${siteData.meta.email}`}
          class="hidden sm:inline-flex items-center gap-1.5 font-medium text-slate-300 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-douitsu-sky shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"></path>
          </svg>
          <span>{siteData.meta.email}</span>
        </a>
      </div>

      <!-- Right: Trilingual Switcher -->
      <div class="flex items-center justify-end shrink-0">
        <div class="inline-flex p-0.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <button
            type="button"
            @click="lang = 'ja'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'ja', 'text-slate-300 hover:text-white': lang !== 'ja' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇯🇵</span>
            <span>日本語</span>
          </button>
          <button
            type="button"
            @click="lang = 'en'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'en', 'text-slate-300 hover:text-white': lang !== 'en' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇺🇸</span>
            <span>English</span>
          </button>
          <button
            type="button"
            @click="lang = 'my'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'my', 'text-slate-300 hover:text-white': lang !== 'my' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇲🇲</span>
            <span>မြန်မာ</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- 2. MAIN NAVBAR (LOGO ON LEFT, BACK ARROW + PAGE TITLE ON RIGHT) -->
  <div class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all duration-300 relative z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-2 sm:py-2.5 gap-2 sm:gap-4">
      
      <!-- Left: Brand Logo -->
      <a
        href="/"
        class="inline-flex items-center gap-2.5 sm:gap-3 group shrink-0"
        aria-label="DOUITSU合同会社 ホーム"
      >
        <div class="logo-animate-wrapper">
          <img
            src="/images/landing/logo-mark.png"
            alt="DOUITSU合同会社 ロゴ"
            class="h-9 sm:h-11 lg:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <div class="logo-shimmer-mask" aria-hidden="true">
            <div class="logo-shimmer-beam"></div>
          </div>
        </div>
        <div class="flex flex-col justify-center min-w-0">
          <div class="flex items-center">
            <span class="font-extrabold text-douitsu-navy text-base sm:text-lg lg:text-xl tracking-tight group-hover:text-douitsu-primary transition-colors leading-tight">
              DOUITSU<span x-show="lang === 'ja'" class="text-xs sm:text-sm font-bold text-slate-700 ml-1">合同会社</span><span x-show="lang !== 'ja'" style="display: none;" class="text-xs sm:text-sm font-bold text-slate-700 ml-1">LLC</span>
            </span>
          </div>
          <span class="text-xs text-slate-500 font-semibold tracking-wide leading-normal mt-0.5 truncate max-w-[140px] xs:max-w-[200px] sm:max-w-none">
            <span x-show="lang === 'ja'">登録支援機関 ({siteData.meta.registrationNo})</span>
            <span x-show="lang === 'en'" style="display: none;">Registered Support Org ({siteData.meta.registrationNo})</span>
            <span x-show="lang === 'my'" style="display: none;">မှတ်ပုံတင်ထောက်ပံ့ရေးအဖွဲ့အစည်း ({siteData.meta.registrationNo})</span>
          </span>
        </div>
      </a>

      <!-- Right: Back to Home Button -->
      <a
        href="/"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl text-xs sm:text-sm font-bold text-douitsu-navy bg-slate-100 hover:bg-douitsu-ice hover:text-douitsu-primary border border-slate-200/90 hover:border-douitsu-primary/30 transition-all duration-200 shadow-2xs group shrink-0"
        aria-label="Back to Home"
      >
        <svg class="w-4 h-4 text-douitsu-primary transition-transform group-hover:-translate-x-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>
          <span x-show="lang === 'ja'">ホームへ戻る</span>
          <span x-show="lang === 'en'" style="display: none;">Back to Home</span>
          <span x-show="lang === 'my'" style="display: none;">ပင်မစာမျက်နှာသို့ ပြန်သွားရန်</span>
        </span>
      </a>

    </div>
  </div>
</header>
