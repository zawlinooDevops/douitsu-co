---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: JOB RECRUITMENT FLYERS GALLERY                      -->
<!-- ID: #section_jobs / 最新の求人情報・求人票 (Job Posters)       -->
<!-- ============================================================ -->
<section
  id="section_jobs"
  class="py-20 md:py-28 bg-slate-50 border-b border-slate-200/60 relative overflow-hidden"
  x-data="{ activeCategory: 'all' }"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-pink-50 border border-pink-200 text-pink-600 text-xs font-bold uppercase tracking-wider mb-3">
        <span x-show="lang === 'ja'">{siteData.jobs.badge.ja}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.jobs.badge.my}</span>
      </span>

      <h2 class="text-3xl sm:text-4xl font-extrabold text-douitsu-navy tracking-tight mb-4">
        <span x-show="lang === 'ja'">{siteData.jobs.title.ja}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.jobs.title.my}</span>
      </h2>

      <p class="text-base text-slate-600 leading-relaxed">
        <span x-show="lang === 'ja'">{siteData.jobs.subtitle.ja}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.jobs.subtitle.my}</span>
      </p>
    </div>

    <!-- Job Flyers Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {siteData.jobs.flyers.map((flyer) => (
        <div
          class="rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col group cursor-pointer"
          @click={`lightboxImg = '${flyer.image}'; lightboxTitle = (lang === 'ja' ? '${flyer.title.ja}' : '${flyer.title.my}')`}
        >
          <!-- Flyer Image Frame -->
          <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
            <img
              src={flyer.image}
              alt={flyer.title.ja}
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/30 transition-colors flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 transition-opacity px-4 py-2 bg-white/95 rounded-xl text-xs font-bold text-douitsu-navy shadow-lg flex items-center gap-1.5">
                <svg class="w-4 h-4 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                </svg>
                拡大表示
              </span>
            </div>

            {flyer.featured && (
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-pink-600 text-white text-[11px] font-bold shadow-md">
                注目求人
              </span>
            )}
          </div>

          <!-- Bottom Card Info -->
          <div class="p-4 flex-1 flex flex-col justify-between bg-white border-t border-slate-100">
            <div>
              <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-50 text-douitsu-primary mb-1.5">
                <span x-show="lang === 'ja'">{flyer.category.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{flyer.category.my}</span>
              </span>
              <h4 class="font-bold text-sm text-douitsu-navy group-hover:text-douitsu-primary transition-colors line-clamp-1">
                <span x-show="lang === 'ja'">{flyer.title.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{flyer.title.my}</span>
              </h4>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span class="text-[11px]">求人詳細を確認</span>
              <span class="text-douitsu-primary font-bold group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Guidance Banner -->
    <div class="mt-12 p-6 rounded-2xl bg-white border border-slate-200 text-center flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="text-left">
        <h4 class="font-bold text-douitsu-navy text-sm sm:text-base">
          <span x-show="lang === 'ja'">ご希望の職種や求人条件についてお気軽にご相談ください</span>
          <span x-show="lang === 'my'" style="display: none;">မိမိလျှောက်ထားလိုသော အလုပ်အကိုင်နှင့် ပတ်သက်၍ အသေးစိတ် စုံစမ်းမေးမြန်းနိုင်ပါသည်</span>
        </h4>
        <p class="text-xs text-slate-500 mt-0.5">
          介護、外食業、飲食料品製造業、各種製造業など全国の求人に対応しております。
        </p>
      </div>

      <a
        href="#section_4"
        class="flex-shrink-0 px-6 py-2.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white text-xs sm:text-sm font-bold shadow-sm transition-colors"
      >
        求人について問い合わせる
      </a>
    </div>

  </div>
</section>
