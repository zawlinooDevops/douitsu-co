---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: HOME / HERO (FULL BACKGROUND MT. FUJI & SAKURA)     -->
<!-- ID: #home (Alias: #section_1) / 登録支援機関                  -->
<!-- ============================================================ -->
<section
  id="home"
  class="relative min-h-[600px] md:min-h-[700px] flex items-center pt-32 pb-16 sm:pt-40 sm:pb-24 lg:pt-44 lg:pb-28 bg-cover bg-center overflow-hidden border-b border-slate-200/60"
  style="background-image: url('/images/landing/hero-bg.webp');"
>
  <!-- Invisible backwards-compatibility anchor -->
  <div id="section_1" class="absolute -top-32"></div>

  <!-- Subtle gradient overlay to enhance legibility and preserve natural Fuji & Sakura scenery -->
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/60 via-slate-900/30 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-xl lg:max-w-2xl">
      
      <!-- Frosted Glassmorphism Card for Crystal Clear Typography -->
      <div class="p-6 sm:p-10 md:p-12 rounded-3xl bg-white/92 backdrop-blur-md border border-white/90 shadow-2xl">
        
        <!-- Trust Badge: Government Registration / Support Org -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50/90 border border-blue-200/80 text-douitsu-blue text-xs font-bold mb-4 sm:mb-5 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-emerald-200 animate-pulse"></span>
          <span x-show="lang === 'ja'">{siteData.hero.badge.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.badge.my}</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-extrabold text-douitsu-navy tracking-tight leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
          <span x-show="lang === 'ja'">{siteData.hero.title.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.title.my}</span>
        </h1>

        <!-- Paragraph Description -->
        <p class="text-slate-700 text-sm sm:text-base font-normal leading-relaxed sm:leading-relaxed mb-7 sm:mb-8">
          <span x-show="lang === 'ja'">{siteData.hero.description.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.description.my}</span>
        </p>

        <!-- Dual Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 sm:gap-4 mb-7 sm:mb-8">
          <!-- Primary CTA: 10 Support Pillars (#support) -->
          <a
            href={siteData.hero.ctaPrimary.href}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white font-bold text-sm sm:text-base shadow-md shadow-blue-500/25 hover:shadow-lg transition-all"
          >
            <span x-show="lang === 'ja'">{siteData.hero.ctaPrimary.ja}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.hero.ctaPrimary.my}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>

          <!-- Secondary CTA: Career / Job Openings (/job.html) -->
          <a
            href={siteData.hero.ctaSecondary.href}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-douitsu-navy border border-slate-300 hover:border-slate-400 font-bold text-sm sm:text-base shadow-xs hover:shadow-sm transition-all"
          >
            <svg class="w-4 h-4 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span x-show="lang === 'ja'">{siteData.hero.ctaSecondary.ja}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.hero.ctaSecondary.my}</span>
          </a>
        </div>

        <!-- Trust Highlights (3 Key Points) -->
        <div class="pt-6 border-t border-slate-200/80">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {siteData.hero.highlights.map((item) => (
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-700 bg-slate-50/80 sm:bg-transparent p-2 sm:p-0 rounded-lg">
                <span class="w-5 h-5 rounded-full bg-blue-100 text-douitsu-primary flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span>
                  <span x-show="lang === 'ja'">{item.ja}</span>
                  <span x-show="lang === 'my'" style="display: none;">{item.my}</span>
                </span>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
