---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: HOME / HERO (FULL BACKGROUND MT. FUJI & SAKURA)     -->
<!-- ID: #home (Alias: #section_1) / 登録支援機関                  -->
<!-- ============================================================ -->
<section
  id="home"
  class="relative min-h-[600px] md:min-h-[70vh] flex items-center pt-32 pb-16 sm:pt-40 sm:pb-20 lg:pt-44 lg:pb-24 bg-cover bg-center overflow-hidden"
  style="background-image: url('/images/landing/hero-bg.webp');"
>
  <!-- Invisible backwards-compatibility anchor -->
  <div id="section_1" class="absolute -top-32"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-xl lg:max-w-2xl">
      
      <!-- Frosted Glassmorphism Card for Crystal Clear Typography -->
      <div class="p-6 sm:p-10 md:p-12 rounded-3xl bg-white/92 backdrop-blur-md border border-white/90 shadow-2xl">
        
        <!-- Main Heading -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-extrabold text-douitsu-navy tracking-tight leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
          <span x-show="lang === 'ja'">{siteData.hero.title.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.hero.title.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.title.my}</span>
        </h1>

        <!-- Paragraph Description -->
        <p class="text-slate-700 text-sm sm:text-base font-normal leading-relaxed sm:leading-relaxed">
          <span x-show="lang === 'ja'">{siteData.hero.description.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.hero.description.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.description.my}</span>
        </p>

      </div>

    </div>
  </div>

  <!-- Bottom Organic SVG Wave Divider (3 Transparent Waves with DOUITSU Logo Colors) -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none z-10 -mb-[1px]">
    <svg
      class="relative block w-full h-12 sm:h-16 md:h-20 lg:h-24 xl:h-28"
      viewBox="0 0 1440 160"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <!-- Wave 1: Logo Deep Navy Blue (#1a486c) - Transparent / Translucent -->
      <path
        d="M0,20 C320,80 600,10 880,50 C1160,90 1340,15 1440,30 L1440,160 L0,160 Z"
        fill="#1a486c"
        fill-opacity="0.3"
      />
      <!-- Wave 2: Logo Primary Blue (#105c8e) - Transparent / Translucent -->
      <path
        d="M0,45 C280,15 540,85 820,40 C1100,0 1300,70 1440,45 L1440,160 L0,160 Z"
        fill="#105c8e"
        fill-opacity="0.45"
      />
      <!-- Wave 3: Logo Sky Blue (#7ba7cc) - Transparent / Translucent -->
      <path
        d="M0,70 C260,105 520,40 780,75 C1040,105 1260,40 1440,65 L1440,160 L0,160 Z"
        fill="#7ba7cc"
        fill-opacity="0.6"
      />
      <!-- Wave 4: Seamless base wave that merges directly into #about bg-white (#ffffff) -->
      <path
        d="M0,95 C280,135 540,75 820,110 C1100,140 1320,85 1440,100 L1440,160 L0,160 Z"
        fill="#ffffff"
      />
    </svg>
  </div>
</section>
