---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: HOME / HERO (FULL BACKGROUND MT. FUJI & SAKURA)     -->
<!-- ID: #home (Alias: #section_1) / 登録支援機関                  -->
<!-- ============================================================ -->
<section
  id="home"
  class="relative min-h-[600px] md:min-h-[700px] flex items-center pt-32 pb-16 sm:pt-40 sm:pb-24 lg:pt-44 lg:pb-28 bg-cover bg-center overflow-hidden border-b border-slate-200/60"
  style="background-image: url('/images/landing/hero-bg.webp');"
>
  <!-- Invisible backwards-compatibility anchor -->
  <div id="section_1" class="absolute -top-32"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-xl lg:max-w-2xl">
      
      <!-- Frosted Glassmorphism Card for Crystal Clear Typography -->
      <div class="p-6 sm:p-10 md:p-12 rounded-3xl bg-white/92 backdrop-blur-md border border-white/90 shadow-2xl">
        
        <!-- Main Heading -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-extrabold text-douitsu-navy tracking-tight leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
          <span x-show="lang === 'ja'">{siteData.hero.title.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.hero.title.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.title.my}</span>
        </h1>

        <!-- Paragraph Description -->
        <p class="text-slate-700 text-sm sm:text-base font-normal leading-relaxed sm:leading-relaxed">
          <span x-show="lang === 'ja'">{siteData.hero.description.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.hero.description.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.description.my}</span>
        </p>

      </div>

    </div>
  </div>
</section>
