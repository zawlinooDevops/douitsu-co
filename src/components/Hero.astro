---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: HOME / HERO (FULL BACKGROUND MT. FUJI & SAKURA)     -->
<!-- ID: #home (Alias: #section_1) / 登録支援機関とは              -->
<!-- ============================================================ -->
<section
  id="home"
  class="relative min-h-[620px] md:min-h-[700px] flex items-center pt-36 pb-20 md:pt-44 md:pb-28 bg-cover bg-center overflow-hidden border-b border-slate-200/60"
  style="background-image: url('/images/landing/hero-bg.webp');"
>
  <!-- Invisible backwards-compatibility anchor -->
  <div id="section_1" class="absolute -top-32"></div>

  <!-- Subtle gradient overlay to enhance legibility and preserve natural Fuji & Sakura scenery -->
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-slate-900/25 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="max-w-xl lg:max-w-2xl">
      
      <!-- Frosted Glassmorphism Card for Crystal Clear Typography -->
      <div class="p-7 sm:p-10 md:p-12 rounded-3xl bg-white/90 backdrop-blur-md border border-white shadow-2xl">
        
        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-douitsu-navy tracking-tight leading-[1.2] mb-5">
          <span x-show="lang === 'ja'">{siteData.hero.title.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.title.my}</span>
        </h1>

        <!-- Paragraph Description -->
        <p class="text-slate-800 text-sm sm:text-base font-medium leading-relaxed mb-8">
          <span x-show="lang === 'ja'">{siteData.hero.description.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.hero.description.my}</span>
        </p>

        <!-- Action Button -->
        <div>
          <a
            href={siteData.hero.cta.href}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white font-bold text-sm sm:text-base shadow-md shadow-blue-500/25 hover:shadow-lg transition-all"
          >
            <span x-show="lang === 'ja'">{siteData.hero.cta.ja}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.hero.cta.my}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
