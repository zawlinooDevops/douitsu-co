---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- HEADER & NAVIGATION (TWO-TIER: TOP INFO BAR + MAIN NAVBAR)   -->
<!-- ============================================================ -->
<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  x-data="{
    mobileMenuOpen: false,
    activeSection: 'home',
    isClicking: false,
    _clickTimer: null,
    sections: ['home', 'about', 'services', 'support', 'flow', 'faq', 'contact'],

    scrollToSection(id) {
      this.activeSection = id;
      this.isClicking = true;
      if (this._clickTimer) clearTimeout(this._clickTimer);
      this._clickTimer = setTimeout(() => {
        this.isClicking = false;
      }, 850);
    },

    updateActive() {
      if (this.isClicking) return;

      // 1. Bottom of page -> contact is active
      const scrollBottom = window.innerHeight + window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      if (scrollBottom >= docHeight - 80) {
        this.activeSection = 'contact';
        return;
      }

      // 2. Very top of page -> home is active
      if (window.scrollY < 120) {
        this.activeSection = 'home';
        return;
      }

      // 3. Scan sections from bottom to top
      const headerOffset = 140;
      for (let i = this.sections.length - 1; i >= 0; i--) {
        const sid = this.sections[i];
        const el = document.getElementById(sid);
        if (el) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= headerOffset) {
            this.activeSection = sid;
            return;
          }
        }
      }
      this.activeSection = 'home';
    },

    init() {
      const hash = window.location.hash.replace('#', '');
      if (hash && this.sections.includes(hash)) {
        this.activeSection = hash;
      }
      window.addEventListener('scroll', () => this.updateActive(), { passive: true });
      window.addEventListener('resize', () => this.updateActive(), { passive: true });
      window.addEventListener('hashchange', () => {
        const h = window.location.hash.replace('#', '');
        if (h && this.sections.includes(h)) {
          this.activeSection = h;
        }
      });
      setTimeout(() => this.updateActive(), 150);
    }
  }"
>
  <!-- 1. TOP INFO BAR -->
  <div class="bg-douitsu-navy text-slate-200 text-xs py-1.5 sm:py-2 border-b border-white/10 shadow-xs relative z-20">
    <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 flex items-center justify-between gap-1 sm:gap-2">
      
      <!-- Left: Tel (Always visible) & Email (sm+) -->
      <div class="flex items-center gap-3 sm:gap-6 text-slate-300 text-xs shrink-0">
        <!-- Phone (Tel) -->
        <a
          href={`tel:${siteData.meta.phoneTel || siteData.meta.phone}`}
          class="inline-flex items-center gap-1 sm:gap-1.5 font-semibold text-slate-200 hover:text-white transition-colors text-xs tracking-tight sm:tracking-wide"
        >
          <svg class="w-3.5 h-3.5 text-douitsu-sky shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>{siteData.meta.phone}</span>
        </a>

        <!-- Email (Hidden on mobile < sm, visible on tablet/desktop sm+) -->
        <a
          href={`mailto:${siteData.meta.email}`}
          class="hidden sm:inline-flex items-center gap-1.5 font-medium text-slate-300 hover:text-white transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-douitsu-sky shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"></path>
          </svg>
          <span>{siteData.meta.email}</span>
        </a>
      </div>

      <!-- Right: Trilingual Switcher -->
      <div class="flex items-center justify-end shrink-0">
        <div class="inline-flex p-0.5 rounded-lg bg-slate-800/80 border border-slate-700">
          <button
            type="button"
            @click="lang = 'ja'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'ja', 'text-slate-300 hover:text-white': lang !== 'ja' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇯🇵</span>
            <span>日本語</span>
          </button>
          <button
            type="button"
            @click="lang = 'en'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'en', 'text-slate-300 hover:text-white': lang !== 'en' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇺🇸</span>
            <span>English</span>
          </button>
          <button
            type="button"
            @click="lang = 'my'"
            :class="{ 'bg-douitsu-primary text-white shadow-xs font-bold': lang === 'my', 'text-slate-300 hover:text-white': lang !== 'my' }"
            class="px-1.5 sm:px-2.5 py-1 text-xs rounded transition-all flex items-center gap-0.5 sm:gap-1 min-h-[30px]"
          >
            <span>🇲🇲</span>
            <span>မြန်မာ</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- 2. MAIN NAVBAR -->
  <div class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all duration-300 relative z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-2 sm:py-2.5">
      
      <!-- Left: Brand Logo (Icon + Company Name & Registration Info Exclusively Here) -->
      <a
        href="/#home"
        @click="scrollToSection('home')"
        class="inline-flex items-center gap-2.5 sm:gap-3 group shrink-0"
        aria-label="DOUITSU合同会社 ホーム"
      >
        <!-- Animated Brand Logo Container (Masked Shimmer Beam) -->
        <div class="logo-animate-wrapper">
          <img
            src="/images/landing/logo-mark.png"
            alt="DOUITSU合同会社 ロゴ"
            class="h-9 sm:h-11 lg:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <div class="logo-shimmer-mask" aria-hidden="true">
            <div class="logo-shimmer-beam"></div>
          </div>
        </div>
        <div class="flex flex-col justify-center min-w-0">
          <div class="flex items-center">
            <span class="font-extrabold text-douitsu-navy text-base sm:text-lg lg:text-xl tracking-tight group-hover:text-douitsu-primary transition-colors leading-tight">
              DOUITSU<span x-show="lang === 'ja'" class="text-xs sm:text-sm font-bold text-slate-700 ml-1">合同会社</span><span x-show="lang !== 'ja'" style="display: none;" class="text-xs sm:text-sm font-bold text-slate-700 ml-1">LLC</span>
            </span>
          </div>
          <span class="text-xs text-slate-500 font-semibold tracking-wide leading-normal mt-0.5 truncate max-w-[190px] sm:max-w-none">
            <span x-show="lang === 'ja'">登録支援機関 ({siteData.meta.registrationNo})</span>
            <span x-show="lang === 'en'" style="display: none;">Registered Support Org ({siteData.meta.registrationNo})</span>
            <span x-show="lang === 'my'" style="display: none;">မှတ်ပုံတင်ထောက်ပံ့ရေးအဖွဲ့အစည်း ({siteData.meta.registrationNo})</span>
          </span>
        </div>
      </a>

      <!-- Right: Main Menu Links + Contact Us Button -->
      <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-0.5 xl:gap-1.5">
        {siteData.navigation.filter(item => item.id !== 'phone' && item.id !== 'contact').map((item) => (
          <a
            href={item.href}
            @click={`scrollToSection('${item.id}')`}
            class="whitespace-nowrap relative px-2 lg:px-2.5 xl:px-3 py-2 rounded-xl text-xs xl:text-sm font-bold transition-all duration-200 shrink-0"
            :class={`activeSection === '${item.id}'
              ? 'text-douitsu-primary bg-douitsu-ice ring-1 ring-douitsu-primary/20 shadow-xs font-extrabold'
              : 'text-slate-700 hover:text-douitsu-primary hover:bg-slate-100/80'`}
          >
            <span x-show="lang === 'ja'">{item.label.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{item.label.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>

            <!-- Bottom Active Accent Pill Indicator -->
            <span
              x-show={`activeSection === '${item.id}'`}
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 scale-x-50"
              x-transition:enter-end="opacity-100 scale-x-100"
              class="absolute bottom-0.5 left-3 right-3 h-0.5 bg-douitsu-primary rounded-full"
              style="display: none;"
            ></span>
          </a>
        ))}

        <!-- Contact Us CTA Button in Main Menu -->
        <a
          href="/#contact"
          @click="scrollToSection('contact')"
          class="whitespace-nowrap ml-1.5 xl:ml-2 inline-flex items-center gap-1.5 px-3 xl:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 shrink-0"
          :class="activeSection === 'contact'
            ? 'bg-douitsu-navy text-white ring-2 ring-douitsu-primary ring-offset-2 shadow-md'
            : 'bg-douitsu-primary hover:bg-douitsu-blue text-white shadow-xs hover:shadow-sm'"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"></path>
          </svg>
          <span x-show="lang === 'ja'">お問い合わせ</span>
          <span x-show="lang === 'en'" style="display: none;">Contact Us</span>
          <span x-show="lang === 'my'" style="display: none;">ဆက်သွယ်ရန်</span>
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="lg:hidden p-2 rounded-xl text-slate-700 hover:text-douitsu-primary hover:bg-slate-100 transition-colors"
        aria-label="Toggle navigation menu"
      >
        <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg x-show="mobileMenuOpen" style="display: none;" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    x-show="mobileMenuOpen"
    x-cloak
    class="lg:hidden bg-white border-b border-slate-200/90 px-4 pt-3 pb-6 shadow-2xl"
    style="display: none;"
  >
    <div class="flex flex-col gap-1.5">
      {siteData.navigation.filter(item => item.id !== 'phone').map((item) => (
        <a
          href={item.href}
          @click={`scrollToSection('${item.id}'); mobileMenuOpen = false`}
          class:list={[
            "px-4 py-2.5 rounded-xl text-sm font-bold transition-all flex items-center justify-between",
            item.id === 'contact'
              ? "mt-2 justify-center shadow-xs"
              : ""
          ]}
          :class={item.id !== 'contact' ? `{
            'text-douitsu-primary bg-douitsu-ice font-extrabold border-l-4 border-douitsu-primary pl-3 shadow-xs': activeSection === '${item.id}',
            'text-slate-800 hover:text-douitsu-primary hover:bg-slate-100/80': activeSection !== '${item.id}'
          }` : `{
            'bg-douitsu-navy text-white ring-2 ring-douitsu-primary ring-offset-2 shadow-md': activeSection === 'contact',
            'bg-douitsu-primary text-white hover:bg-douitsu-blue': activeSection !== 'contact'
          }`}
        >
          <span class="flex items-center gap-2">
            {item.id === 'contact' && (
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"></path>
              </svg>
            )}
            <span x-show="lang === 'ja'">{item.label.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{item.label.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{item.label.my}</span>
          </span>
          {item.id !== 'contact' && (
            <span
              x-show={`activeSection === '${item.id}'`}
              class="w-2 h-2 rounded-full bg-douitsu-primary"
              style="display: none;"
            ></span>
          )}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-slate-100 flex flex-col gap-2">
        <a
          href={`tel:${siteData.meta.phoneTel || siteData.meta.phone}`}
          class="w-full text-center py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors flex items-center justify-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>TEL: {siteData.meta.phone}</span>
        </a>
        <a
          href={`mailto:${siteData.meta.email}`}
          class="w-full text-center py-1 text-slate-500 hover:text-slate-800 text-xs font-medium"
        >
          <span>{siteData.meta.email}</span>
        </a>
      </div>
    </div>
  </div>
</header>
