---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION 3: SERVICES FEATURES                                 -->
<!-- ID: #section_3 / 特定技能・外国人採用支援サービスの特徴          -->
<!-- ============================================================ -->
<section
  id="section_3"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Circular Avatar Badge -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-white shadow-md">
          <img src="/images/landing/handshake-contract.jpg" alt="契約締結" class="w-full h-full object-cover" />
        </div>
        <span class="inline-flex items-center px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-douitsu-blue text-xs font-bold uppercase tracking-wider">
          <span x-show="lang === 'ja'">{siteData.services.badge.ja}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.services.badge.my}</span>
        </span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-extrabold text-douitsu-navy tracking-tight mb-4">
        <span x-show="lang === 'ja'">{siteData.services.title.ja}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.services.title.my}</span>
      </h2>

      <p class="text-base text-slate-600 leading-relaxed">
        <span x-show="lang === 'ja'">
          DOUITSU合同会社は、特定技能外国人材の受入れ計画作成から入国手続、就労後の日常支援までを一貫して代行いたします。
        </span>
        <span x-show="lang === 'my'" style="display: none;">
          သတ်မှတ်ကျွမ်းကျင်လုပ်သား ခေါ်ယူမှု အစီအမံ ရေးဆွဲခြင်း၊ ပြည်ဝင်ခွင့်ဗီဇာ ပြင်ဆင်ခြင်းမှသည် အလုပ်ခွင်နှင့် နေ့စဉ်ဘဝ စောင့်ရှောက်မှုအထိ တစ်နေရာတည်းတွင် ပြီးပြည့်စုံစွာ ဝန်ဆောင်မှုပေးပါသည်။
        </span>
      </p>

    </div>

    <!-- 3 Core Service Feature Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {siteData.services.cards.map((card) => (
        <div class="rounded-3xl bg-slate-50 border border-slate-200/80 p-6 sm:p-7 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
          <div>
            
            <!-- Top Badges & Sakura Icon -->
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-pink-100 text-pink-700 border border-pink-200 shadow-xs">
                <span x-show="lang === 'ja'">{card.badge.ja}</span>
                <span x-show="lang === 'my'" style="display: none;">{card.badge.my}</span>
              </span>
              <img src="/images/landing/cherry-48.png" alt="桜" class="w-6 h-6 object-contain opacity-80 group-hover:opacity-100 transition-opacity" />
            </div>

            <!-- Card Title -->
            <h3 class="text-lg sm:text-xl font-bold text-douitsu-navy mb-3 group-hover:text-douitsu-primary transition-colors leading-snug">
              <span x-show="lang === 'ja'">{card.title.ja}</span>
              <span x-show="lang === 'my'" style="display: none;">{card.title.my}</span>
            </h3>

            <!-- Card Image Preview / Flyer -->
            <div class="mb-4 rounded-2xl overflow-hidden border border-slate-200 bg-white shadow-xs cursor-pointer"
                 @click={`lightboxImg = '${card.image}'; lightboxTitle = (lang === 'ja' ? '${card.title.ja}' : '${card.title.my}')`}>
              <img
                src={card.image}
                alt={card.title.ja}
                class="w-full h-48 object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="px-3 py-1.5 bg-slate-900/5 text-slate-500 text-[11px] text-center font-medium">
                クリックで拡大表示
              </div>
            </div>

            <!-- Card Description -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              <span x-show="lang === 'ja'">{card.desc.ja}</span>
              <span x-show="lang === 'my'" style="display: none;">{card.desc.my}</span>
            </p>

          </div>

          <!-- Bottom Action link -->
          <div class="pt-6 mt-6 border-t border-slate-200/60">
            <a
              href="#section_4"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-douitsu-primary hover:text-douitsu-blue transition-colors group-hover:translate-x-1 duration-200"
            >
              <span>この分野について相談する</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
