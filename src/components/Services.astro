---
import { siteData } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---

<!-- ============================================================ -->
<!-- SECTION: SERVICES (サービス特徴)                              -->
<!-- ID: #services (Alias: #section_3)                            -->
<!-- ============================================================ -->
<section
  id="services"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden scroll-mt-24"
>
  <div id="section_3" class="absolute -top-24"></div>

  <!-- Background Pattern: Japanese Shippo (七宝 - Interlocking Connection Circles) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-[0.035]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="services-shippo" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="0" cy="0" r="20" fill="none" stroke="#105c8e" stroke-width="1.2" />
          <circle cx="40" cy="0" r="20" fill="none" stroke="#105c8e" stroke-width="1.2" />
          <circle cx="0" cy="40" r="20" fill="none" stroke="#105c8e" stroke-width="1.2" />
          <circle cx="40" cy="40" r="20" fill="none" stroke="#105c8e" stroke-width="1.2" />
          <circle cx="20" cy="20" r="20" fill="none" stroke="#105c8e" stroke-width="1.2" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#services-shippo)" />
    </svg>
  </div>


  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <SectionHeader
      eyebrow="OUR SERVICES"
      title={siteData.services.title}
      subtitle={siteData.services.subtitle}
    />

    <!-- 3 Worker Program Cards (SSW1, SSW2, Ikusei Shuro) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {siteData.services.programs.map((program) => (
        <div class="rounded-2xl bg-white border border-slate-200/90 hover:border-douitsu-primary/50 p-6 sm:p-7 shadow-sm hover:shadow-card transition-all duration-300 flex flex-col justify-between relative group hover:-translate-y-1 overflow-hidden">
          
          <!-- Top Accent Line on Hover -->
          <div class={`absolute top-0 left-0 right-0 h-1 transition-opacity duration-300 opacity-0 group-hover:opacity-100 ${
            program.theme === 'blue'
              ? 'bg-gradient-to-r from-douitsu-primary to-douitsu-sky'
              : program.theme === 'indigo'
              ? 'bg-gradient-to-r from-indigo-600 to-douitsu-accent'
              : 'bg-gradient-to-r from-emerald-600 to-teal-400'
          }`}></div>

          <div>
            <!-- Program Title Lockup (Icon + Main Headline + Subtitle) -->
            <div class="flex items-start gap-3.5 mb-3">
              <!-- Custom Icon Box by Track -->
              <div class={`w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center shadow-xs border ${
                program.theme === 'blue'
                  ? 'bg-gradient-to-br from-blue-50 to-white border-blue-200/80 text-douitsu-primary'
                  : program.theme === 'indigo'
                  ? 'bg-gradient-to-br from-indigo-50 to-white border-indigo-200/80 text-indigo-600'
                  : 'bg-gradient-to-br from-emerald-50 to-white border-emerald-200/80 text-emerald-600'
              }`}>
                {program.id === 'ssw-1' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                )}
                {program.id === 'ssw-2' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                )}
                {program.id === 'ikusei-shuro' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                )}
              </div>

              <div>
                <h3 class="text-lg sm:text-xl font-extrabold text-douitsu-navy tracking-tight leading-normal sm:leading-snug group-hover:text-douitsu-primary transition-colors">
                  <span x-show="lang === 'ja'">{program.title.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.title.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.title.my}</span>
                </h3>
                <p class="text-xs font-semibold text-slate-500 mt-0.5 leading-normal">
                  <span x-show="lang === 'ja'">{program.subtitle.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.subtitle.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.subtitle.my}</span>
                </p>
              </div>
            </div>

            <!-- Divider -->
            <div class="h-[1px] w-full bg-slate-100 my-3"></div>

            <!-- Description -->
            <p class="text-sm text-slate-600 leading-relaxed mb-4 min-h-[4.5rem]">
              <span x-show="lang === 'ja'">{program.description.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{program.description.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{program.description.my}</span>
            </p>

            <!-- Key Specifications Table Box -->
            <div class="bg-slate-50/90 rounded-xl p-3 border border-slate-200/70 text-xs space-y-2 mb-4">
              <div class="flex items-center justify-between pb-1.5 border-b border-slate-200/50">
                <span class="text-slate-500 font-medium">
                  <span x-show="lang === 'ja'">{program.specs.duration.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.duration.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.duration.label.my}</span>
                </span>
                <span class="font-bold text-douitsu-navy">
                  <span x-show="lang === 'ja'">{program.specs.duration.value.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.duration.value.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.duration.value.my}</span>
                </span>
              </div>

              <div class="flex items-center justify-between pb-1.5 border-b border-slate-200/50">
                <span class="text-slate-500 font-medium">
                  <span x-show="lang === 'ja'">{program.specs.family.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.family.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.family.label.my}</span>
                </span>
                <span class="font-bold text-douitsu-navy">
                  <span x-show="lang === 'ja'">{program.specs.family.value.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.family.value.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.family.value.my}</span>
                </span>
              </div>

              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">
                  <span x-show="lang === 'ja'">{program.specs.requirement.label.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.requirement.label.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.requirement.label.my}</span>
                </span>
                <span class="font-bold text-douitsu-navy text-right">
                  <span x-show="lang === 'ja'">{program.specs.requirement.value.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{program.specs.requirement.value.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{program.specs.requirement.value.my}</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Bottom Trust Badge & Action -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-1.5 text-douitsu-primary font-bold min-w-0">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span class="block truncate sm:text-clip">
                <span x-show="lang === 'ja'">{program.supportBadge.ja}</span>
                <span x-show="lang === 'en'" style="display: none;">{program.supportBadge.en}</span>
                <span x-show="lang === 'my'" style="display: none;">{program.supportBadge.my}</span>
              </span>
            </div>
            <a
              href="#contact"
              class="shrink-0 whitespace-nowrap inline-flex items-center gap-1 font-bold text-slate-500 hover:text-douitsu-primary transition-colors"
            >
              <span x-show="lang === 'ja'">相談する</span>
              <span x-show="lang === 'en'" style="display: none;">Consult</span>
              <span x-show="lang === 'my'" style="display: none;">မေးမြန်းရန်</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Consultation Callout Box -->
    <div class="mt-12 rounded-2xl bg-gradient-to-r from-douitsu-navy via-douitsu-dark to-douitsu-blue p-6 sm:p-8 text-white shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-douitsu-sky text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span x-show="lang === 'ja'">受入れ企業様・求職者様向け 個別相談受付中</span>
          <span x-show="lang === 'en'" style="display: none;">Individual Consultation Open for Companies & Candidates</span>
          <span x-show="lang === 'my'" style="display: none;">လုပ်ငန်းရှင်များနှင့် အလုပ်ရှာဖွေသူများအတွက် အခမဲ့တိုင်ပင်ဆွေးနွေးနိုင်ပါသည်</span>
        </div>
        <h4 class="text-lg sm:text-xl font-bold tracking-tight leading-normal sm:leading-snug">
          <span x-show="lang === 'ja'">貴社の業種や人材要件に最適な在留資格プランをご提案いたします</span>
          <span x-show="lang === 'en'" style="display: none;">We propose the optimal visa and support strategy tailored to your industry</span>
          <span x-show="lang === 'my'" style="display: none;">သင့်လုပ်ငန်းခွင်နှင့် အကိုက်ညီဆုံးဖြစ်မည့် ဗီဇာအစီအစဉ်များကို ဆွေးနွေးအကြံပြုပေးပါသည်</span>
        </h4>
        <p class="text-sm text-slate-300">
          <span x-show="lang === 'ja'">制度改正への対応、受入れ人数枠、必要書類の作成など、まずはお気軽にご相談ください。</span>
          <span x-show="lang === 'en'" style="display: none;">Feel free to inquire about legal reforms, quota regulations, or required documentation.</span>
          <span x-show="lang === 'my'" style="display: none;">ဥပဒေစနစ်သစ် ပြောင်းလဲမှုများ၊ ခေါ်ယူနိုင်သော ဝန်ထမ်းဦးရေနှင့် လိုအပ်သော စာရွက်စာတမ်းများကို ဆွေးနွေးနိုင်ပါသည်။</span>
        </p>
      </div>

      <a
        href="#contact"
        class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-douitsu-ice text-douitsu-navy font-bold text-sm shadow-md transition-all hover:scale-102"
      >
        <span x-show="lang === 'ja'">無料相談・お問い合わせ</span>
        <span x-show="lang === 'en'" style="display: none;">Free Consultation</span>
        <span x-show="lang === 'my'" style="display: none;">အခမဲ့ ဆွေးနွေးမေးမြန်းရန်</span>
        <svg class="w-4 h-4 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
