---
import { siteData } from '../data/content';
---

<!-- ============================================================ -->
<!-- SECTION: SERVICES (サービス特徴)                              -->
<!-- ID: #services (Alias: #section_3)                            -->
<!-- ============================================================ -->
<section
  id="services"
  class="py-20 md:py-28 bg-white border-b border-slate-200/60 relative overflow-hidden"
>
  <div id="section_3" class="absolute -top-24"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-douitsu-navy tracking-tight">
        <span x-show="lang === 'ja'">{siteData.services.title.ja}</span>
        <span x-show="lang === 'en'" style="display: none;">{siteData.services.title.en}</span>
        <span x-show="lang === 'my'" style="display: none;">{siteData.services.title.my}</span>
      </h2>
    </div>

    <!-- 3 Feature Cards (Accurately matching original structure) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      
      <!-- Card 1: Official Registration Document / Flyer -->
      <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-end mb-4">
            <img src="/images/landing/cherry-48.png" alt="桜" class="w-6 h-6 object-contain opacity-80" />
          </div>

          <div
            class="rounded-xl overflow-hidden border border-slate-200 bg-white shadow-xs cursor-pointer"
            @click={`lightboxImg = '${siteData.services.card1.image}'; lightboxTitle = (lang === 'ja' ? '${siteData.services.card1.alt.ja}' : (lang === 'en' ? '${siteData.services.card1.alt.en}' : '${siteData.services.card1.alt.my}'))`}
          >
            <img
              src={siteData.services.card1.image}
              alt={siteData.services.card1.alt.ja}
              class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-102"
              loading="lazy"
            />
            <div class="px-3 py-1.5 bg-slate-900/5 text-slate-500 text-[11px] text-center font-medium">
              <span x-show="lang === 'ja'">クリックで拡大表示</span>
              <span x-show="lang === 'en'" style="display: none;">Click to enlarge</span>
              <span x-show="lang === 'my'" style="display: none;">နှိပ်၍ အကြီးချဲ့ကြည့်ရှုရန်</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Tokutei Ginou Explanation -->
      <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-douitsu-navy">
              <span x-show="lang === 'ja'">{siteData.services.card2.title.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{siteData.services.card2.title.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{siteData.services.card2.title.my}</span>
            </h3>
            <img src="/images/landing/cherry-48.png" alt="桜" class="w-6 h-6 object-contain opacity-80" />
          </div>

          <p class="text-sm text-slate-700 leading-relaxed">
            <span x-show="lang === 'ja'">{siteData.services.card2.text.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{siteData.services.card2.text.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.services.card2.text.my}</span>
          </p>
        </div>
      </div>

      <!-- Card 3: Service Details (内容サービス) -->
      <div class="rounded-2xl bg-slate-50 border border-slate-200/80 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-douitsu-navy">
              <span x-show="lang === 'ja'">{siteData.services.card3.title.ja}</span>
              <span x-show="lang === 'en'" style="display: none;">{siteData.services.card3.title.en}</span>
              <span x-show="lang === 'my'" style="display: none;">{siteData.services.card3.title.my}</span>
            </h3>
            <img src="/images/landing/cherry-48.png" alt="桜" class="w-6 h-6 object-contain opacity-80" />
          </div>

          <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
            {siteData.services.card3.items.map((item, idx) => (
              <li class="flex items-start gap-2">
                <span class="text-douitsu-primary font-bold">{idx + 1}.</span>
                <span>
                  <span x-show="lang === 'ja'">{item.ja}</span>
                  <span x-show="lang === 'en'" style="display: none;">{item.en}</span>
                  <span x-show="lang === 'my'" style="display: none;">{item.my}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

  </div>
</section>
