---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/content';

const title = `404: ページが見つかりません | ${siteData.meta.companyName}`;
const description = siteData.notFound.description.ja;
---

<Layout title={title} description={description}>
  <!-- HEADER & NAVIGATION -->
  <Navbar />

  <!-- MAIN 404 NOT FOUND SECTION -->
  <main class="min-h-[82vh] pt-32 pb-20 flex items-center justify-center bg-douitsu-ice/60 relative overflow-hidden">
    
    <!-- Ambient Background Glow Orbs -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-douitsu-sky/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-douitsu-sakura-soft/60 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Background Subtle Dot-Grid Pattern -->
    <div class="absolute inset-0 opacity-[0.035] pointer-events-none" style="background-image: radial-gradient(#105c8e 1.5px, transparent 1.5px); background-size: 24px 24px;"></div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full text-center">
      
      <!-- Glassmorphic Card -->
      <div class="p-8 sm:p-12 md:p-14 rounded-3xl bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-xl">
        
        <!-- Error Badge Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          <span x-show="lang === 'ja'">{siteData.notFound.badge.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.notFound.badge.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.notFound.badge.my}</span>
        </div>

        <!-- Large Stylized 404 Display Number -->
        <div class="text-7xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-douitsu-primary via-douitsu-blue to-douitsu-navy tracking-tight leading-none mb-6 select-none">
          404
        </div>

        <!-- Main Title (Trilingual) -->
        <h1 class="text-2xl sm:text-3xl font-bold text-douitsu-navy mb-4 leading-snug">
          <span x-show="lang === 'ja'">{siteData.notFound.title.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.notFound.title.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.notFound.title.my}</span>
        </h1>

        <!-- Description Paragraph (Trilingual) -->
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto mb-8 leading-relaxed">
          <span x-show="lang === 'ja'">{siteData.notFound.description.ja}</span>
          <span x-show="lang === 'en'" style="display: none;">{siteData.notFound.description.en}</span>
          <span x-show="lang === 'my'" style="display: none;">{siteData.notFound.description.my}</span>
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-10">
          <!-- Back to Home -->
          <a
            href="/#home"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-douitsu-primary hover:bg-douitsu-blue text-white font-bold text-sm shadow-md transition-all cursor-pointer group"
          >
            <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <span x-show="lang === 'ja'">{siteData.notFound.backHome.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{siteData.notFound.backHome.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.notFound.backHome.my}</span>
          </a>

          <!-- Contact Us -->
          <a
            href="/#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-douitsu-navy font-bold text-sm border border-slate-300 shadow-xs transition-all cursor-pointer"
          >
            <svg class="w-4 h-4 text-douitsu-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span x-show="lang === 'ja'">{siteData.notFound.contactUs.ja}</span>
            <span x-show="lang === 'en'" style="display: none;">{siteData.notFound.contactUs.en}</span>
            <span x-show="lang === 'my'" style="display: none;">{siteData.notFound.contactUs.my}</span>
          </a>
        </div>

        <!-- Mini Contact & Registration Footer Box -->
        <div class="pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium">{siteData.meta.registrationNo}</span>
          </div>
          <div class="flex items-center gap-4">
            <a href={`tel:${siteData.contact.phone.tel || siteData.contact.phone.value}`} class="font-bold text-douitsu-primary hover:underline flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span>{siteData.contact.phone.value}</span>
            </a>
            <span class="text-slate-300">|</span>
            <a href={`mailto:${siteData.contact.email.value}`} class="text-slate-600 hover:text-douitsu-primary hover:underline">
              {siteData.contact.email.value}
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- SITE FOOTER -->
  <Footer />
</Layout>
