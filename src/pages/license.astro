---
import Layout from '../layouts/Layout.astro';
import SubpageNavbar from '../components/SubpageNavbar.astro';
import SubpageContent from '../components/SubpageContent.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/content';

const { licensePage } = siteData;
---

<Layout
  titles={licensePage.metaTitle}
  descriptions={licensePage.metaDescription}
>
  <!-- SUBPAGE HEADER (TOP INFO BAR + LOGO & BACK TO HOME BUTTON) -->
  <SubpageNavbar />

  <!-- Top Spacer to offset the fixed header -->
  <div class="h-[88px] sm:h-[108px] lg:h-[112px] shrink-0 pointer-events-none" aria-hidden="true"></div>

  <main>
    <!-- CONTENT SECTION (RICH CORPORATE LAYOUT) -->
    <SubpageContent data={licensePage} />
  </main>

  <!-- FOOTER -->
  <Footer />
</Layout>
