---
import '../styles/global.css';
import { siteData } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = siteData.meta.title.ja,
  description = siteData.meta.description.ja,
  ogImage = siteData.meta.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteData.meta.siteUrl).toString();
---

<!doctype html>
<html lang="ja" class="scroll-smooth" x-data="{ lang: (typeof localStorage !== 'undefined' && localStorage.getItem('douitsu_lang')) || 'ja', lightboxImg: null, lightboxTitle: '', mobileMenuOpen: false }">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="DOUITSU LLC / DOUITSU合同会社" />
    <meta name="keywords" content="DOUITSU LLC, DOUITSU合同会社, 登録支援機関, 特定技能, 1号特定技能, ミャンマー特定技能, 外国人採用, 介護特定技能, 外食業特定技能, 清瀬市, 支援計画" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" as="image" href="/images/landing/hero-bg.webp" type="image/webp" fetchpriority="high" />

    <!-- Favicon & Device Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DOUITSU LLC (DOUITSU合同会社)" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Theme Color & Mobile App Meta -->
    <meta name="theme-color" content="#1e3a8a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": siteData.meta.companyName,
      "alternateName": siteData.meta.companyNameEn,
      "url": siteData.meta.siteUrl,
      "logo": `${siteData.meta.siteUrl}/images/landing/logo.png`,
      "image": `${siteData.meta.siteUrl}/images/landing/banner.jpg`,
      "description": siteData.meta.description.ja,
      "telephone": siteData.meta.phone,
      "email": siteData.meta.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "元町1-11-21 フローレス元町205号",
        "addressLocality": "清瀬市",
        "addressRegion": "東京都",
        "postalCode": "204-0021",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 35.7876,
        "longitude": 139.5298
      }
    })} />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans selection:bg-douitsu-primary selection:text-white relative">
    
    <!-- Slot for Page Content -->
    <slot />

    <!-- Alpine.js Global Lightbox Modal -->
    <div
      x-show="lightboxImg !== null"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      @keydown.escape.window="lightboxImg = null"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/85 backdrop-blur-md"
      style="display: none;"
    >
      <div
        @click.outside="lightboxImg = null"
        class="relative max-w-4xl max-h-[92vh] w-full bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col border border-white/20"
      >
        <div class="flex items-center justify-between px-6 py-4 bg-slate-900 text-white border-b border-slate-800">
          <h3 class="font-bold text-lg text-slate-100 truncate pr-4" x-text="lightboxTitle"></h3>
          <button
            @click="lightboxImg = null"
            class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition-colors"
            aria-label="Close"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="p-4 overflow-auto flex-1 flex items-center justify-center bg-slate-950/40">
          <img :src="lightboxImg" :alt="lightboxTitle" class="max-h-[75vh] w-auto object-contain rounded-lg shadow-lg" />
        </div>
        <div class="px-6 py-3 bg-slate-100 flex items-center justify-between border-t border-slate-200 text-sm">
          <span class="text-slate-600 font-medium">
            <span x-show="lang === 'ja'">DOUITSU合同会社 登録支援機関</span>
            <span x-show="lang === 'en'" style="display: none;">DOUITSU LLC (Registered Support Organization)</span>
            <span x-show="lang === 'my'" style="display: none;">DOUITSU LLC (မှတ်ပုံတင်ထောက်ပံ့ရေးအဖွဲ့အစည်း)</span>
          </span>
          <a
            :href="lightboxImg"
            download
            class="inline-flex items-center gap-2 px-4 py-1.5 bg-douitsu-primary text-white text-xs font-semibold rounded-lg hover:bg-douitsu-blue transition-colors shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span x-show="lang === 'ja'">画像を保存</span>
            <span x-show="lang === 'en'" style="display: none;">Save Image</span>
            <span x-show="lang === 'my'" style="display: none;">ပုံကို ဒေါင်းလုဒ်ရယူရန်</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Alpine.js Local Bundle Execution -->
    <script>
      import Alpine from 'alpinejs';
      // Load saved language or default to Japanese
      const savedLang = localStorage.getItem('douitsu_lang') || 'ja';
      // @ts-ignore
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
